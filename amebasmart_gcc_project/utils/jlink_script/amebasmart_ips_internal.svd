        <register>
          <name>DPI_CTRL_2</name>
          <addressOffset>0x00000240</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>rst_dqsen_cal</name>
              <description>1'b0: disable reset fw_tm_dqs_en_ftun when reset dqsen_gen
1'b1: enable reset fw_tm_dqs_en_ftun when reset dqsen_gen</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>set_reg_valid_mode</name>
              <description>[0] trigger set_reg_valid manually
[1] trigger set_reg_valid automatically</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rst_3point_mode</name>
              <description>Reset dqsen_gen mode
[00] disable reset 3 point
[01] force reset 3 point
[10] reserved
[11] during refresh</description>
              <bitRange>[27:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rst_dqsen_mode</name>
              <description>Reset dqsen_gen mode
[00] disable reset RX dqsen_gen
[01] force reset RX dqsen_gen
[10] reserved
[11] during refresh</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>alert_ena</name>
              <description>DFI alert output enable</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>alert_1_ena</name>
              <description>DFI alert_1 output enable</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rd_update_dly</name>
              <description>Update delay chain setting after read data enable
Cmd domain
2to1 mode : &gt; 1/2 rd_update_dly_rx +N
1to1 mode : &gt;       rd_update_dly_rx +N</description>
              <bitRange>[21:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
