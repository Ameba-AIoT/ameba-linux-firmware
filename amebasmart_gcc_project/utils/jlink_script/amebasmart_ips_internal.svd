              <description>1: TE only move in one direction, and Delta only decrease. This mode should only be used in offline or fore-ground calibration to find the minimum working Rx delay taps.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>delta_force</name>
              <description>force delta value without double-buffer</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>vr_upd_3</name>
              <description>1: vref_s_3 can be applied to Vref pad by fw_set_rd_dly</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>vr_upd_2</name>
              <description>1: vref_s_2 can be applied to Vref pad by fw_set_rd_dly</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>vr_upd_1</name>
              <description>1: vref_s_1 can be applied to Vref pad by fw_set_rd_dly</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>vr_upd_0</name>
              <description>1: vref_s_0 can be applied to Vref pad by fw_set_rd_dly</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
