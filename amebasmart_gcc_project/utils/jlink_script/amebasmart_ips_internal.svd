              <description>Headphone left channel enable depop control (0: disable, 1: enable)</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HPO_ENDPR</name>
              <description>Headphone right channel enable depop control (0: disable, 1: enable)</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HPO_L_POW</name>
              <description>Headphone left channel power down control (0: power down, 1: power on)</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HPO_MDPL</name>
              <description>Headphone left channel mute depop mode control (0: no depop, 1: depop)</description>
              <bitRange>[15:15]</bitRange>
