2'b10: 24 bits
2'b11: 8 bits</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_ch_len_sel_tx</name>
              <description>I2S 1 Tx channel channel length
2'b00: 16 bits
2'b01: 32 bits
2'b10: 24 bits
2'b11: 8 bits</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_ch_len_sel_rx</name>
              <description>I2S 1 Rx channel chennel length
2'b00: 16 bits
2'b01: 32 bits
2'b10: 24 bits
2'b11: 8 bits</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_data_ch_sel_tx</name>
              <description>I2S 1 Tx channel data channel
2'b00: L/R
2'b01: R/L
2'b10: L/L
2'b11: R/R</description>
              <bitRange>[19:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_master_sel</name>
              <description>I2S 1 master source selection
1'b0: SPORT internal
1'b1: external I2S</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
