          <size>32</size>
          <description>command buffer starve register 1</description>
          <resetValue>0x00010000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HPR_STARVE_DIS</name>
              <description>0x1: Disable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HPR_MAX_STARVE</name>
              <description>HPR entry of command buffer is not serviced before it goes to expired in the interval time= {HPR_MAX_STARVE, timestamp_cycle}</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CBSTARVE2</name>
          <addressOffset>0x00000490</addressOffset>
          <size>32</size>
          <description>command buffer starve register 2</description>
          <resetValue>0x00010000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LPW_STARVE_DIS</name>
              <description>0x1: Disable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LPW_MAX_STARVE</name>
              <description>LPW entry of command buffer is not serviced before it goes to expired in the interval time= {LPW_MAX_STARVE, timestamp_cycle}</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CBSTARVE3</name>
          <addressOffset>0x00000494</addressOffset>
          <size>32</size>
          <description>command buffer starve register 3</description>
          <resetValue>0x00010000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LPR_RMW_STARVE_DIS</name>
              <description>0x1: Disable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LPR_RMW_MAX_STARVE</name>
              <description>lpr_rmw cmd que of command buffer is not serviced before it goes to expired in the interval time= {LPR_RMW_MAX_STARVE, timestamp_cycle}</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CBSTARVE4</name>
          <addressOffset>0x00000498</addressOffset>
          <size>32</size>
          <description>command buffer starve register 4</description>
          <resetValue>0x00010000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LPW_RMW_STARVE_DIS</name>
              <description>0x1: Disable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LPW_RMW_MAX_STARVE</name>
              <description>lpw_rmw re-insert cmd of command buffer is not serviced before it goes to expired in the interval time= {LPW_RMW_MAX_STARVE, timestamp_cycle}</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
