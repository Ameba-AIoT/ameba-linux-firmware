          <fields>
            <field>
              <name>FRD_CMD</name>
              <description>READ_FAST_SINGLE (or RD_OCTA_IO)
Indicates SPI Flash command value of fast read command. The baud rate is used with FBAUDR. 
FRD_CMD[15:8] is for RD_OCTA_IO_CMD_2nd_BYTE (only available when configuration of DDR_EN is defined)
FRD_CMD[7:0] is for RD_OCTA_IO_CMD_1st_BYTE</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
