    <peripheral>
      <name>ED25519_REG</name>
      <baseAddress>0x400ec000</baseAddress>
      <size>0x00000204</size>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x00000204</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>ENG_INITR</name>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <description>EdDSA Engine Initial Setting Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>eng_clk_enable</name>
              <description>EdDSA engine clock enable signal.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>eng_rst</name>
              <description>EdDSA engine synchronization reset.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ENG_CONF_INTR</name>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <description>EdDSA Engine Configure Interrupt Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ENG_DECODE_FAIL</name>
              <description>Engine decode fail interrupt. Put high to clear fail interrupt.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE3_FINISH</name>
              <description>Engine mode3 interrupt. Put high to clear mode3 interrupt.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE2_FINISH</name>
              <description>Engine mode2 interrupt. Put high to clear mode2 interrupt.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE1_FINISH</name>
              <description>Engine mode1 interrupt. Put high to clear mode1 interrupt.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE0_FINISH</name>
              <description>Engine mode0 interrupt. Put high to clear mode0 interrupt.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENG_IDLE</name>
              <description>When engine is busy, this bit will be put high.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HASH_OK</name>
              <description>When Hash digest input value is ready, put hask_ok to high.
Only use this bit in some auto-flow setting. When programer set this bit to 1'b1, it means that hash digest input value is ready, engine can contiune processing next auto-flow step.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENG_START</name>
              <description>Start for EdDSA function. It's almost for all EdDSA function, except some auto-flow settings. When programer set this bit to 1'b1, it means that input values of the engine mode are ready, so engine can process the mode. Usually it won't be set with HASH_OK.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ENG_CTRLR</name>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <description>EdDSA Engine Control Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>YO2_WORD_SWAP</name>
              <description>Byte swap
    1'b1: |7:0 | 15:8 | 23:16 | 31:24|
    1'b0: |31:24 | 23:16 | 15:8 |7:0|
Word swap
    1'b1: | Word0 | Word1 | Word2 | Word3 | Word4 | Word5 | Word6 | Word7 |
    1'b0: | Word7 | Word6 | Word5 | Word4 | Word3 | Word2 | Word1 | Word0 |</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>YO2_BYTE_SWAP</name>
              <description>merged</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>XO2_WORD_SWAP</name>
              <description>merged</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>XO2_BYTE_SWAP</name>
              <description>merged</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>YO1_WORD_SWAP</name>
              <description>merged</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>YO1_BYTE_SWAP</name>
              <description>merged</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>XO1_WORD_SWAP</name>
              <description>merged</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>XO1_BYTE_SWAP</name>
              <description>merged</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Y2_WORD_SWAP</name>
              <description>merged</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Y2_BYTE_SWAP</name>
              <description>merged</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>X2_WORD_SWAP</name>
              <description>merged</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>X2_BYTE_SWAP</name>
              <description>merged</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Y1_WORD_SWAP</name>
              <description>merged</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Y1_BYTE_SWAP</name>
              <description>merged</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>X1_WORD_SWAP</name>
              <description>merged</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>X1_BYTE_SWAP</name>
              <description>merged</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE3_F_MASK</name>
              <description>Mask mode3 finish interrupt</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE2_F_MASK</name>
              <description>Mask mode2 finish interrupt</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE1_F_MASK</name>
              <description>Mask mode1 finish interrupt</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE0_F_MASK</name>
              <description>Mask mode0 finish interrupt</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ENG_DECODE_FAIL_MASK</name>
              <description>Mask decoding fail interrupt</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RECOVER_X_EN</name>
              <description>Reocver (decode) point enable contrl. When this bit is set to 1'b1, it means that enable decoding mode.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SUB_POINT</name>
              <description>Point subtraction enable control in mode2.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MOD_Q</name>
              <description>Select modular1 or 2 for Hash mod.
Modular1: hash[511:0] modular (2^255 - 19)
Modular2: hash[511:0] modular 
(2^252+ 27742317777372353535851937790883648493)</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>H512_EN</name>
              <description>SHA512 hash enable control.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BYP_H512</name>
              <description>SHA512 hash bypass mode control.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AUTO_SP</name>
              <description>Auto-flow step enable control. Basically, it is used to open one pass flow in mode0/mode1 flow. 
It won't be set in mode2/mode3.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AP_EN</name>
              <description>Add point enable control. It is only used in mode3.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FUN_SEL</name>
              <description>EdDSA Basic Function selection
2'd0:
* Decode point
* Add point
* Sub mod
It depends on ECOVER_X_EN and AP_EN.
2'd1: Div mode 
2'd2: Add mode
2'd3:
* Mult mod
* Hash mod #modular1
* Hash mod #modular2.
It depends on H512_EN and MOD_Q.</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MOD_SEL</name>
              <description>EdDSA mode selection
2'd0: Mode0
2'd1: Mode1
2'd2: Mode2
