            </field>
            <field>
              <name>cal_lead0</name>
              <description>Central point shift right control when 3-point calibration result is lead[0] = 1.
[2's complement format] (sign, 2.0)
000: 0
001: 1
010: 2
011: 3
[Note]
lead[3] &lt;- lead[2] &lt;- lead[1] &lt;- lead[0] &lt;- central</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>
