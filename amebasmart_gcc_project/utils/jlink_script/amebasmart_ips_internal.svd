              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cal_lag0</name>
              <description>Central point shift left control when 3-point calibration result is lag[0] = 1.
[2's complement format] (sign, 2.0)
111: -1
110: -2
101: -3
100: -4
[Note]
central -&gt; lag[0] -&gt; lag[1] -&gt; lag[2] -&gt; lag[3]</description>
