          <addressOffset>0x0000041C</addressOffset>
          <size>32</size>
          <description>DRAM channel address remap control register 0, remap channel address bit 0</description>
          <resetValue>0x00000019</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CH_REMAP</name>
              <description>BFO = 2, mapping to BUS_ADDR_BIT = BFO+CH_REMAP +log2(dq/8), if unused mapping to 0</description>
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BG_REMAP0</name>
          <addressOffset>0x00000420</addressOffset>
          <size>32</size>
          <description>DRAM bgaddress remap control register 0, remap bgaddress bit 0 ~bit1</description>
          <resetValue>0x0000016A</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BG1_REMAP</name>
              <description>BFO = 2, mapping to BUS_ADDR_BIT = BFO+BG1_REMAP+log2(dq/8), if unused mapping to 0</description>
              <bitRange>[9:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BG0_REMAP</name>
              <description>BFO = 2, mapping to BUS_ADDR_BIT = BFO+BG0_REMAP+log2(dq/8), if unused mapping to 0</description>
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADDR_REMAP_CTRL</name>
          <addressOffset>0x00000424</addressOffset>
          <size>32</size>
          <description>NONBINARY dram density: 3/6/12/24Gb</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>NONB_DSIZE</name>
              <description>For LPDDR2/3 non-binary dram density (3/6/12/24Gb), only half of the row address space is valid. When the row[MSB]=1, the row[MSB-1] must be LOW.
But now DRAM_SIZE(0x230) is used to set the max density. DRAM_SIZE can be non-binary size. So ADDR_REMAP_CTRL (0x424) would be not necessary for non-binary dram density.
If physical address &gt; dram_size, it is illegal DRAM access, frontend will block this cmd not send to backend, and send ERROR response.
Also frontend interrupt  will asserted for this illegal access.
3'd0: Not support non-binary dram density
3'd1: No dram density present at address with row[13]=row[12]=1
3'd2: No dram density present at address with row[14]=row[13]=1
3'd3: No dram density present at address with row[15]=row[14]=1
3'd4: No dram density present at address with row[16]=row[15]=1
3'd5~3'd7: Reserverd</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SLOT_PARK</name>
          <addressOffset>0x00000460</addressOffset>
          <size>32</size>
          <description>Slot parking control register</description>
          <resetValue>0x00400000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IDLE_WINOW</name>
              <description>If current slot is no commands and current slot is not perfer parking slot, to wait IDLE_WINDOW cyclesand turn aroundslot if current slot is still no commands.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PERF_PARK</name>
              <description>0: Read slot
1: Write slot</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SLOT_STARVE</name>
          <addressOffset>0x00000464</addressOffset>
          <size>32</size>
          <description>Slot starvation control register</description>
          <resetValue>0xFF020104</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BASE_STARVE_CYC</name>
              <description>This is basic starvation counter cycles for LPR_STARVE_CYC, HPR_STARVE_CYC and LPW_STARVE_CYC</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LPR_STARVE_CYC</name>
              <description>The timeout of LPR slot would be set when LPR commans is no servicing in the interval time = (LPR_STARVE_CYC*BASE_STARVE_CYC)</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HPR_STARVE_CYC</name>
              <description>The timeout of HPR slot would be set when HPR commans is no servicing in the interval time = (HPR_STARVE_CYC*BASE_STARVE_CYC)</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LPW_STARVE_CYC</name>
              <description>The timeout of LPW slot would be set when HPR commans is no servicing in the interval time = (LPW_STARVE_CYC*BASE_STARVE_CYC)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SLOT_CNTR</name>
          <addressOffset>0x00000468</addressOffset>
          <size>32</size>
          <description>Slot constrain register</description>
          <resetValue>0x00201020</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LPR_ISU_LMT</name>
              <description>This is limited number to issue LPR commands when LPR slot is at urgent state.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HPR_ISU_LMT</name>
              <description>This is limited number to issue HPR commands when HPR slot is at urgent state.</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LPW_ISU_LMT</name>
              <description>This is limited number to issue LPW commands when LPW slot is at urgent state.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EXP_CTRL</name>
          <addressOffset>0x0000046C</addressOffset>
          <size>32</size>
          <description>Expire control register</description>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXP_BASE</name>
              <description>Used for expire function, exp_base value count down to 1, global_exp_timer+1</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HZD_CTRL0</name>
          <addressOffset>0x00000470</addressOffset>
          <size>32</size>
          <description>Hazard priority control register 0</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RHZD_THD</name>
              <description>Used to constrain read hazard priority.
When RHZD_THD setting and read command number &gt;= RHZD_THD, it would keep the original read hazard priority at command QoS.
If the value of RHZD_THD is 0, it would disable this hazard constrain function.</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WHZD_THD</name>
              <description>Used to constrain write hazard priority.
When WHZD_THD setting and write command number &gt;= WHZD_THD, it would keep the original write hazard priority at command QoS. 
If the value of WHZD_THD is 0, it would disable this hazard constrain function.</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HZD_CTRL1</name>
          <addressOffset>0x00000474</addressOffset>
          <size>32</size>
          <description>Hazard priority control register 0</description>
          <resetValue>0x0FFF0FFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RHZD_CRDT_NUM</name>
              <description>This is the max. number to limit the read hazard credit number. 
When read hazard credit number is larger then 0, it would keep the original read hazard priority at command QoS.
If RHZD_CRDT_NUM is 0, it would disable this hazard constrain function.</description>
              <bitRange>[31:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RHZD_CRDT_CYC</name>
              <description>Read hazard credit number would added 1 to in every interval cycles (RHZD_CRDT_CYC).</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WHZD_CRDT_NUM</name>
              <description>This is the max. number to limit the write hazard credit number.
When write hazard credit number is larger then 0, it would keep the original write hazard priority at command QoS.
If WHZD_CRDT_NUM is 0, it would disable this hazard constrain function.</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WHZD_CRDT_CYC</name>
              <description>Write hazard credit number would add 1 to in every interval cycles (WHZD_CRDT_CYC).</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CBCTL0</name>
          <addressOffset>0x00000480</addressOffset>
          <size>32</size>
          <description>Command buffer control register 0</description>
          <resetValue>0x000F0010</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LPR_RMW_RUN_LEN</name>
              <description>When CBSTARVE3.LPR_RMW_MAX_STARVEreaches,lpr_rmwcmd que's priority will increase higher thanthe LPR inputexpired cmd and be serviced continuously LPR_RMW_RUN_LENlpr_rmw cmd when lpr_rmw cmd que's is not empty.</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LPR_FREESLOT_NUM</name>
              <description>Number of Free-slot for LP reads is the value +1; Due to HP reads share w/ LP reads in the Read Command Buffer, the number of Free-slot for HP reads is the value : 32 - (LPR_FREESLOT_NUM + 1)</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CBCTL1</name>
          <addressOffset>0x00000484</addressOffset>
          <size>32</size>
          <description>Command buffer control register 1</description>
          <resetValue>0x000F0E00</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PAGE_HIT_THR_WR</name>
              <description>When PAGE_HIT_THR_WR_EN=1, the cmd_buf for write same bank page_hit cmd threshold value is PAGE_HIT_THR_WR.</description>
              <bitRange>[31:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PAGE_HIT_THR_RD</name>
              <description>When PAGE_HIT_THR_RD_EN=1, the cmd_buf for read same bank page_hit cmd threshold value is PAGE_HIT_THR_RD</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LPW_RMW_RUN_LEN</name>
              <description>When CBSTARVE4.LPW_RMW_MAX_STARVE reaches, lpw_rmw re-insert cmd priority will increase higher thanthe LPW inputexpired cmd &amp; expired re-insert and be serviced continuously LPW_RMW_RUN_LENlpw_rmw cmd when lpr_rmw re-insert cmd is valid.</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>W_HAZ_EXP_CTRL</name>
              <description>For RAW/WAW hit wcmd_entry triggers expired function to speed up hazard handler.
W_HAZ_EXP_CTRL[1:0]
2'b11: always enable
2'b10: urgent only for read/write urgent signal assert
2'b0x: disable
When W_HAZ_EXP_CTRL[3:2]
2'b1x: RAW hazard
2'bx1: WAW hazard
2'b00: disable
Default function is urgent only.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PAGE_HIT_THR_WR_EN</name>
              <description>when PAGE_HIT_THR_RD_EN=1, the cmd_buf for write same bank page_hit cmd threshold value is PAGE_HIT_THR_WR</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PAGE_HIT_THR_RD_EN</name>
              <description>when PAGE_HIT_THR_RD_EN=1, the cmd_buf for read same bank page_hit cmd threshold value is PAGE_HIT_THR_RD</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PAGEOPEN</name>
              <description>When PAGEOPEN =1,the last cmd of each bank will not be issued with auto-precharge to PCTL.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DIS_WMG</name>
              <description>Write merge function disable, it only works when enable WMG_EN feature.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CBSTARVE0</name>
          <addressOffset>0x00000488</addressOffset>
          <size>32</size>
          <description>command buffer starve register 0</description>
          <resetValue>0x00010000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LPR_STARVE_DIS</name>
              <description>0x1: Disable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LPR_MAX_STARVE</name>
              <description>LPR entry of command buffer is not serviced before it goes to expired in the interval time= {LPR_MAX_STARVE, timestamp_cycle}</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
