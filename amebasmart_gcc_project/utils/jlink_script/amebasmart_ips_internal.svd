              <description>Threshold to determine quasi speech occurrence
Range: 4'h0 ~ 4'h7</description>
              <bitRange>[29:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_peak_search_thr2</name>
              <description>Higher threshold for peak search</description>
              <bitRange>[25:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_peak_search_thr</name>
              <description>Threshold for peak search</description>
              <bitRange>[15:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_onset_mask</name>
              <description>Force the onset output of each subband to 1
6'h00_0001: force the onset output of subband 1 to 1
6'h00_0010: force the onset output of subband 2 to 1
6'h00_0100: force the onset output of subband 3 to 1
6'h00_1000: force the onset output of subband 4 to 1
6'h01_0000: force the onset output of subband 5 to 1
6'h10_0000: force the onset output of subband 6 to 1</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PITCH_DET_CTRL5</name>
          <addressOffset>0x00000024</addressOffset>
          <size>32</size>
          <description>Pitch Detection Control Register 5</description>
          <resetValue>0x038ED87D</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>pitch_det_st_abs_keep_thr</name>
              <description>The accumulated time when pitch_det_st_abs_chk_num keeps checking
check time = REG * 4ms</description>
              <bitRange>[31:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_st_abs_chk_num</name>
              <description>The threshold for checking the absolute energy variation</description>
              <bitRange>[20:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_st_7_c_6_en</name>
              <description>Enable control of comparison between st_6 &amp; st_7 for high pitch case</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_st_4_7_var_thr</name>
              <description>The threshold for checking the energy variation in subband 4~7</description>
              <bitRange>[16:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_speech_interval_thr</name>
              <description>The time interval for pitch_det_flag to decide the non-speech data after pitch_det_flag_hold is high
check time = REG * 4ms</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PITCH_DET_CTRL6</name>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <description>Pitch Detection Control Register 6</description>
          <resetValue>0x00E8206A</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>pitch_det_thr_st_valid</name>
