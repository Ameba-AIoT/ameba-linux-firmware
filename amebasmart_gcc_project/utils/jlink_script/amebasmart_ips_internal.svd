            <field>
              <name>IR_RX_FIFO_ERROR_INT_CLR</name>
              <description>Rx FIFO error read interrupt
Write 1 to clear</description>
              <bitRange>[5:5]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>IR_RX_CNT_THR_INT_CLR</name>
