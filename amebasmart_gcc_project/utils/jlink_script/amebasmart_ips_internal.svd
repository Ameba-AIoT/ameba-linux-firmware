              <bitRange>[20:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_xzero_tone_en</name>
              <description>Tone detection enable control
0: disable
1: enable</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_xzero_det_en</name>
              <description>xzero detection enable control
0: disable
1: ebable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_xzero_cycle_eq_num</name>
              <description>The number of equivalent cycles
Range: 3'h0 ~ 3'h5</description>
              <bitRange>[13:11]</bitRange>
              <access>read-write</access>
            </field>
