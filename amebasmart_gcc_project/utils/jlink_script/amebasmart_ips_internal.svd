              <access>read-write</access>
            </field>
            <field>
              <name>fen_lpon</name>
              <description>LS global reset
1: Enable LS function
0: Disable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_gdet_vd09_pos</name>
              <description>1: Enable glitch detect for swr0p9 posedge
0: disable</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_gdet_vd09_neg</name>
              <description>1: Enable glitch detect for swr0p9 negedge
0: disable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_gdet1_vd18_pos</name>
              <description>1: Enable glitch detect for swr psram posedge
0: Reset AON timer</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_gdet1_vd18_neg</name>
              <description>1: Enable glitch detect for swr psram negedge
0: disable</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_gdet2_vd18_pos</name>
              <description>1: Enable glitch detect for swr mem posedge
0: disable</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_gdet2_vd18_neg</name>
              <description>1: Enable glitch detect for swr mem negedge
0: disable</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_gdet_vd33_pos</name>
              <description>1: Enable glitch detect for vd33 posedge
0: disable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_gdet_vd33_neg</name>
              <description>1: Enable glitch detect for vd33 negedge
0: disable</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_atim</name>
              <description>1: Enable AON timer
0: Reset AON timer
Note: AON timer starts to run only when event happens.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_iwdg</name>
              <description>1: Enable IWDG by HW autoload.
Once enabled, IWDG can't be disabled unless por asserts.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_bor_acc</name>
              <description>Enable high acc bor reset function, default is 0 when power on</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fen_bor</name>
              <description>Enable bor reset function, default is 0 when power on</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_CLK</name>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000003</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>cke_osc4m_force</name>
              <description>[i] = 1 : Force osc4m enable for certain path .
[i] = 0 : osc4m enable for certain path is determined by normal control
[24]:otpc
[25]:aip xtal
[26]:peri
[27]:platform
[28]:VAD
[29]:wlan,bt
Note, this field is for SW control,[30-31]is retain for SW</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_sdm32k</name>
              <description>1: Enable 32.768K SDM module's clock
0: Disable</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_lp4m</name>
              <description>1: Enable lp syson plfm 4m clock
0: Disable
Note: this bit will set/clr by HW pmc</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_rtc</name>
              <description>1: Enable RTC clock
0: Disable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_atim</name>
              <description>1: Enable AON timer clock
0: Disable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_aon</name>
              <description>if 1, AON clock will be gated except PMC and this register.
Note: AON clock can't be shutdown by analog need.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
