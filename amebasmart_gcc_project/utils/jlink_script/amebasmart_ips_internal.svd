              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_pwroff_rd_wait_cycle</name>
              <description>clk on  wait cycle when RD is end, 
0: wait 1 mck_mc cycle
1: wait 8 mck_mc cycles
2: wait 8x2 mck_mc cycles
3: wait 8x3 mck_mc cycles,etc.</description>
              <bitRange>[11:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_pwroff_wr_wait_cycle</name>
              <description>clk on  wait cycle when WR is end
0: wait 1 mck_mc cycle
1: wait 8 mck_mc cycles
2: wait 8x2 mck_mc cycles
3: wait 8x3 mck_mc cycles,etc.</description>
              <bitRange>[8:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_rw_pwroff_mode</name>
              <description>rw blk clocks gating mode:
0: no gating
1: no REF and dfi_pwr = 0, 
2: no REF/WR/RD
3: no REF and (no WR/RD or dfi_pwr = 0)</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_ca_pwroff_mode</name>
              <description>CMD/ADDR clocks gating mode:
0: no gating
1: gating DPI clock when dfi_pwr = 0
2: gating DPI clock and DCK when dfi_pwr = 0
3: reserved</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
