        <register>
          <name>REG_OTP_SYSCFG2</name>
          <addressOffset>0x00000108</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>USB_PHY_UTMI_POS_OUT</name>
              <description>All output signals on UTMI interface are triggered at positive edge of UTMI clock</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_REG_SITX</name>
              <description>Control magnitude of HSTX output swing
IBX_TX = 3.125*sitx+125 (uA)
Default : 3.125*8+125 = 150 (uA)
IBXDP/IBXDM = 120*IBX_TX
Default : 120*0.15 (mA) = 18 (mA)
HSDP/HSDM = 18(mA)*45 (Ω) /2 = 405 mV
sitx (4-bit): REG_SITX[3:0]
IBX_TX(uA): current for HSTX output swing control
IBXDP/IBXDM : HSTX DP (or DM) output current
HSDP/HSDM : HSTX DP (or DM) output voltage</description>
              <bitRange>[30:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_REG_SRC</name>
              <description>USB PHY slew-rate (rise time ,tr /fall time ,tf) control of HSDP,HSDM, tr:
000: 560ps ,   001: 530ps
010: 500ps ,   011: 470ps
100: 440ps ,   101: 420ps
110: 390ps ,   111: 370ps</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_SENH_OBJ</name>
              <description>USB PHY host squelch level calibration target</description>
              <bitRange>[23:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_SEND_OBJ</name>
              <description>USB PHY device squelch level calibration target</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_SW_RSVD</name>
              <description></description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_SREN</name>
              <description>Enable USB PHY new slew rate control for HSTX
0: disable
1: enable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_REG_SRM</name>
              <description>USB PHY new slew-rate (rise time ,tr /fall time ,tf) control of HSTX</description>
              <bitRange>[13:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_REG_SRVH</name>
              <description>USB PHY high voltage level of control signal of new slew rate control for HSTX</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_Z0_AUTO_K</name>
              <description>USB PHY Zo auto calibration mode
0: Manual mode, Zo value is from REG_Z0_ADJR
1: Auto mode, Zo value is from Zo_Tune</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_Z0_ADJR</name>
              <description>USB PHY Zo value of manual mode</description>
              <bitRange>[6:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_RX_BOOST</name>
              <description>USB PHY AC boost gain of HSRX amp
00: 0dB
01: 3.3dB
10: 6.9dB
11: 9.3dB</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_CAL_EN</name>
              <description>USB PHY calibration enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_OTP_SYSCFG3</name>
          <addressOffset>0x0000010C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>USB_RSVD7</name>
              <description>HW para for USB usage</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_RSVD6</name>
              <description>HW para for USB usage</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_RSVD5</name>
              <description>HW para for USB usage</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_RSVD4</name>
              <description>HW para for USB usage</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_NSQ_DEL_SEL</name>
              <description>Modify to RX packet min packet delay 32 bit times.
Need delay more than 8 stages in 32 bit times condition.
00:delay 6 stages
01:delay 9 stages
10:delay 11 stages
11:delay 13 stages</description>
              <bitRange>[6:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_REG_WATER_LEVEL_CLEAN_SEL</name>
              <description>Modify to RX packet min packet delay 32 bit times.
Need set 0 in 32 bit times condition.
water_level_clean condition:
1'b1: [(start_receive)| (|curr_case)] (old_mode)
1'b0: [(|curr_case)]   (new_mode)</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_REG_DISABLE_EB_WAIT4IDLE</name>
              <description>Modify to RX packet min packet delay 32 bit times.
If first RX packet is too long and water level is too big, need disable EB wait4idle.
1'b0:enable EB wait4idle
1'b1:disable EB wait4idle</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_REG_NSQ_VLD_SEL</name>
              <description>Modify to RX packet min packet delay 32 bit times.
1'b1:(NSQ_d[9:0])|NSQ_s  (old mode)
1'b0:(NSQ_d[5:0])|NSQ_s  (new mode)</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>USB_PHY_REG_LATE_DLLEN</name>
              <description>Modify to TX2RX packet min packet delay 8 bit times. Need less than 7T in 8 bit times condition.
HSDLLEN will be asserted to start RX 100ns after TX is done if LATE_DLLEN is set. Else if LATE_DLLEN is cleared, only 66ns duration will be set. This is used to avoid the reception of ECHO following the TX issued by PHY itself.
2'B00:3T
2'B01:5T
2'B10:7T
2'B11:11T</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
