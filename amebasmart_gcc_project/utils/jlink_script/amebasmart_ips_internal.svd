              <access>read-write</access>
            </field>
            <field>
              <name>BIT_VOQ_RD_RESP_EN</name>
              <description>Enable VOQ RD responder function</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_NOA0_PKT_LIFETIME_CTRL</name>
