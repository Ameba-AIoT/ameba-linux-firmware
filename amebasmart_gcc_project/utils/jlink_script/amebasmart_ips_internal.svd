        <register>
          <name>ELR_PLD0</name>
          <addressOffset>0x00000200</addressOffset>
          <size>32</size>
          <description>Error transaction information 0</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ERR_BSTINDEX</name>
              <description>Burst index inside a burst that trigger fault. Always 0 in RXI-316</description>
              <bitRange>[31:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ERR_BSTLEN</name>
              <description>Burst length of error transaction after chopped.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ERR_BSTTYPE</name>
              <description>BurstSeq of the error request.</description>
              <bitRange>[13:11]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ERR_CMD</name>
              <description>Cmd of the error request.
3'h1: write
3'h2: read</description>
              <bitRange>[10:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ERR_SRC</name>
              <description>Error source.
Always 0 in RXI-316</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_PLD1</name>
          <addressOffset>0x00000204</addressOffset>
          <size>32</size>
          <description>Error transaction information 1</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ERR_MREQINFO</name>
              <description>Request information {axlock, axprot,axcache} of error transaction</description>
              <bitRange>[31:23]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ERR_SIZE</name>
              <description>AXI Size of the error request.</description>
              <bitRange>[18:16]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_ID</name>
          <addressOffset>0x00000208</addressOffset>
          <size>32</size>
          <description>ID of error transaction</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ERR_ID</name>
              <description>AXI ID of the error request. This ID combines AXI ID and port ID</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_ADR0</name>
          <addressOffset>0x0000020C</addressOffset>
          <size>32</size>
          <description>Lower part address of error transaction</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Lower_part_of_address</name>
              <description>Address[31:0] of the error request.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_ADR1</name>
          <addressOffset>0x00000210</addressOffset>
          <size>32</size>
          <description>Higher part address of error transaction</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Higher_part_of_address</name>
              <description>Address[63:32] of the error request.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_CODE</name>
          <addressOffset>0x00000214</addressOffset>
          <size>32</size>
          <description>Error type</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Error_Core</name>
              <description>The error code of error request.
8'b0: Secure fault</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_CTRL</name>
          <addressOffset>0x0000023C</addressOffset>
          <size>32</size>
          <description>Error interrupt clear</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELR_INTR_CLR</name>
              <description>Error log interrupt clear. Writing 1'b1 to the register will trigger a 1-cycle pulse interrupt clear. It has to write 1'b1 to this register every time when the error exception occurs. Note that this register is write-only, the return value of reading this register is meaningless</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG_P0_RQOS</name>
          <addressOffset>0x00000800</addressOffset>
          <size>32</size>
          <description>Port0 Read QoS value</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>rqos_map_region2</name>
              <description>Traffic class of region 2.
0: LPR
1: VPR
2: HPR</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rqos_map_region1</name>
              <description>Traffic class of region 1.
0: LPR
1: VPR
2: HPR</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rqos_map_region0</name>
              <description>Traffic class of region 0.
0: LPR
1: VPR
2: HPR</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rqos_map_level2</name>
              <description>Separation level2 indicating the end of region 1 mapping.
Region1 starts from (rqos_map_level1 + 1) to rqos_map_level2.
Region2 starts from (rqos_map_level2 + 1) to 15.
e.g. {rqos_map_level1, rqos_map_level2, rqos_map_region0, rqos_map_region1, rqos_map_region0} = {6, 13, 0, 1, 2}.
QoS 0~6 is LPR, QoS 7~13 is VPR, and QoS 14~15 is HRP.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rqos_map_level1</name>
              <description>Separation level1 indicating the end of region 0 mapping.
Region0 starts from 0 to rqos_map_level1.
e.g. rqos_map_level1 is 6, and rqos_map_region0 is 0. QoS 0 ~ 6 is LPR.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG_P0_WQOS</name>
          <addressOffset>0x00000804</addressOffset>
