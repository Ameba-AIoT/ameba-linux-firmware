            <field>
              <name>pin_mux_mode</name>
              <description>1'b1 : pin_mux bypass mode
1'b0 : pin_mux mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_lpddr_en</name>
              <description>1'b1 : LPDDR mode enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_dat_rate_sel</name>
              <description>1'b0 : 2to1 mode 
mck_cmd = mck_mc = 1/2 DCK
1'b1 : 1to1 mode 
mck_cmd = mck_mc =       DCK</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_ddr2_en</name>
              <description>ddr2_en=1 &amp; ddr3_mod=1
DDR2(LPDDR2) mode
ddr2_en=0 &amp; ddr3_mod=1
DDR3(LPDDR3) mode
ddr2_en=0 &amp; ddr3_mod=0
DDR4 mode</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_ddr3_mode</name>
              <description>ddr2_en=1 &amp; ddr3_mod=1
DDR2(LPDDR2) mode
ddr2_en=0 &amp; ddr3_mod=1
DDR3(LPDDR3) mode
ddr2_en=0 &amp; ddr3_mod=0
DDR4 mode</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
