              <bitRange>[5:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BIT_UPD_BFMEE_NC</name>
              <description>Nc Index of MIMO control field [2:0] for VHT (B2-0) , [1:0] for HT mode (B1-0)</description>
