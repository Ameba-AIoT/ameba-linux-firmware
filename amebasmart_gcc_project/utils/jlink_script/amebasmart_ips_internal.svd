        <register>
          <name>DPI_CTRL_0</name>
          <addressOffset>0x00000238</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>en_crc</name>
              <description>[1] CRC enable (post one T more) for DDR4 only
[0] no CRC</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>2t_wr_pre</name>
              <description>[1] 2T preamble for DDR4 only(Write)
[0] 1T preamble</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>data_pre</name>
              <description>1: Enable Tx DQ preamble, enable this function will add 2T write delay in 2to1 mode, or 1T write delay in 1to1 mode</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>data_init</name>
              <description>Set the Tx initial value of DQ/DM</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cal_dqsen_update_ena</name>
              <description>Enable HW auto-update tm_dqsen_ftun calibration value</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cal_dqsen_mode</name>
              <description>tm_dqs_en calibration set mode
[00] during no read operation
[01] during refresh
[10] [11] disable auto calibration</description>
              <bitRange>[18:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>2t_rd_pre</name>
              <description>[1] 2T preamble for DDR4 only (READ)
[0] 1T preamble</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ref_update_dly</name>
              <description>Update delay chain setting after receiving refresh command</description>
              <bitRange>[13:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cal_set_mode</name>
              <description>3-point calibration set mode
[00] during no read operation
[01] during refresh
[10] immediately
[11] disable auto calibration</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rst_fifo_mode</name>
              <description>Reset read FIFO pointer mode
[00] during no read operation
[01] during refresh
[10] disable reset FIFO pointer
[11] force reset FIFO pointer</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fw_set_mode</name>
              <description>FW set delay chain of data slice mode
[00] READ:during no read;
        WRITE: during refresh
[01] during refresh
[10] immediately
[11] reserved</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPI_CTRL_1</name>
