0: Disable</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_psram</name>
              <description>1: Enable PSRAM bus clock
0: Disable</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_ac</name>
              <description>1: Enable audio codec clock
0: Disable</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_ddrp</name>
              <description>1: Enable ddr phy clock
0: Disable</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_ddrc</name>
              <description>1: Enable ddrc clock
0: Disable</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_irda</name>
              <description>1: Enable irda clock
0: Disable</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_ipc_hp</name>
              <description>1: Enable IPC clock
0: Disable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_sdh</name>
              <description>1: Enable SD HOST bus clock
0: Disable</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_trng</name>
              <description>1: Enable trng bus clock
0: Disable</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_ledc</name>
              <description>1: Enable ledc bus clock
0: Disable</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_usb</name>
              <description>1: Enable USB bus clock
0: Disable</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_spi1</name>
              <description>1: Enable SPI1 clock
0: Disable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_spi0</name>
              <description>1: Enable SPI0 clock
0: Disable</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_wmac</name>
              <description></description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_gdma</name>
              <description>1: Enable GDMA0 clock
0: Disable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_lcdcmipi</name>
              <description>1: Enable LCDC&amp;MIPI clock
0: Disable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_ipsec</name>
              <description>1: Enable ipsec clock
0: Disable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_lx1</name>
              <description>1: Enable lx1 bus clock
0: Disable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_hperi</name>
              <description>1: Enable hperi clock . If IP using hperi clk , this bit must be set .
0: Disable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_CKE_GRP2</name>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>cke_tim</name>
              <description>Timer0-13 clock enable
0-7 : lp basic timer
8 :    pwm timer
9:    pulse timer
13-10 : hp basic timer</description>
              <bitRange>[29:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_sport</name>
              <description>1: Enable 4path sport clock
0: Disable</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_uart</name>
              <description>1: Enable Uart1 clock 
0: Disable</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_CKE_GRP</name>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00030F01</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>cke_xtal_lps_grp</name>
              <description>XTAL lps clock(312.5K) for different use , when neither func used .
[0]: system SDM 32K
[1]: bt lps clk
Note : This field only used for HW debug , software needn't to config it for normal function.</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_xtal_grp</name>
              <description>XTAL 40M clock used for different use , when neither func used 
[0]: LP system
[1]: 40M peri
[2]: 2M peri
[3]: 40M for NP when xtal is in LPS mode
Note : This field only used for HW debug , software needn't to config it for normal function.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cke_osc4m_grp</name>
              <description>OSC4M used for different use , when neither func used , osc4m can be disabled .
0: LP system 4M 
1: OSC2M peri
2: WL/BT common
3: WL ana clock
4: BT ana clock
5: SDH ana clock
6: aip func control
7: vad
Note : This field only used for HW debug , software needn't to config it for normal function.
Not use, move to aon reg: cke_osc4m_force</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_CKSL_GRP0</name>
          <addressOffset>0x00000024</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x8F002544</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>cksl_psram</name>
              <description>psram phy clock seleck
0: xtal 40M
1: nppll divided clock , max to 300M</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_hipc</name>
              <description>hs_ipc clock select
0: hapb clk
1: lpon clk(4M)</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_vad</name>
              <description>audio codec vad clock select
0: osc4m output
1: xtal 40M divider 10 output .
Note : make xtal enter lps mode when vad work to save power</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_adc2m</name>
              <description>ADC 2M seleck 
0: osc4M divider 2
1: xtal 40M divider out</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_sport</name>
              <description>sport clock selection 
0: equal to audio codec main clock (40M)
1: from I2S pll , after i2s pll selection and divider</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_xtal</name>
              <description>xtal selection, Default=40MHz
0000: 40MHz
0001: 25MHz
0010: 13MHz
0011: 19.2MHz
0100: 20MHz
0101: 26MHz
0110: 38.4MHz
0111: 17.664MHz
1000: 16MHz
1001: 14.138MHz
1010: 12MHz
1011: 52MHz
1100: 48MHz
1101: 27MHz
1110: 24MHz
1111: none</description>
              <bitRange>[23:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_uart2m</name>
              <description>Uart 2M seleck 
0: osc4M divider 2
1: xtal 40M divider out</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_uart</name>
              <description>Select uart rx clock for every uart . (Note uart3 is BT uart , always 40M)
0: rx clock is xtal 40M
1: rx clock is 2M (osc2M or xtal divided 2M)</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_sdm</name>
              <description>sdm 128 clock select , this must be fixed after initial selection.
0:osc128
1:xtal lps 312.5K</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_vadm</name>
              <description>vad share memory clock select . Note, it must first change this bit to 1,and then shutdown hs plfm . When wakeup , it must first enable hs plfm , finally set this bit to 0 .
0: used by hs plfm clock
1: used by vad buffer ctrol</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_ac</name>
              <description>audio codec main clock selection 
0: syspll divided 40M
1: xtal 40M</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_loguart2m</name>
              <description>Loguart 2M seleck 
0: osc4M divider 2
1: xtal 40M divider out</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_loguart</name>
              <description>Select loguart trx clock 
0: clock is xtal 40M
1: clock is 2M</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_hbus</name>
              <description>HP bus clock seletion
1: from nppll divider output , which default is 100M
0: from xtal 40M clock</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_np</name>
              <description>NP(KM4) clock seletion
1: from nppll divider output , which default is 320M
0: from xtal 40M clock</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_ctc</name>
              <description>CTC REG clock selection
0: 131k
1: LS APB Clock</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_adc</name>
              <description>ADC INT clock selection
0: LS APB clock
1: OSC2M</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_gpio</name>
              <description>GPIO INT clock selecton:
0: LS APB clock
1: 32.768K clock from SDM</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_spic</name>
              <description>SPIC clock sel:
00/10: OSC4M
01: XTAL 40M
11: nppll divided out,max to 200M</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_lsoc</name>
              <description>KM0 cpu clock seletion
2'b00/2'b01:  ANA4M
2'b10/2'b11:  XTAL</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_CKD_GRP0</name>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x0E439113</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ckd_mipi</name>
              <description>mipi vo clock divider, it is based on nppll clock
Max timing signoff clock is 66.7M .
Default is 800/12 = 66.7
divider by this value + 1</description>
              <bitRange>[29:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_hperi</name>
              <description>audio main clock divider, it is based on np pll output
0~2 : not valid
3: div4
4: div5
other: divider by this value + 1</description>
              <bitRange>[22:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_ac</name>
              <description>audio main clock divider, it is based on np pll output
0~2 : not valid
3: div20
4: div21
other: divider by this value + 17</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_hbus</name>
              <description>ahb clock divider, it is based on np pll output
0~6 : not valid
7: div8
8: div9
other: divider by this value + 1</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_psram</name>
              <description>PSRAM phy clock divider, it is based on np pll (600M).
0: not valid
1: div2
2: div3
3/other: divider by this value + 1</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_plfm</name>
              <description>PLFM clock divider, it is based on np clock  .
0: not valid
1: div2 (it is better to fix in this value)
2: div3
3/other: divider by this value + 1</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_np</name>
              <description>NP clock divider, it is based on np pll (800M).
0: not valid
1: div2
2: div3
3/other: divider by this value + 1</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_CKD_GRP1</name>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000FA0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ckd_xtal_2m</name>
              <description>Output divided clock frequency for UART:
BIT_LSYS_UART_XTAL_DIV_FREQ/1000  (MHz)</description>
              <bitRange>[15:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_xtal_2m_en</name>
              <description>1: enable XTAL division circuit for UART</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_SW_RST_CTRL</name>
          <addressOffset>0x00000038</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>apsys_rst</name>
              <description>Only when REG_SW_RST_TRIG is 0x69696969 , this reg can be write</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>npsys_rst</name>
              <description>Only when REG_SW_RST_TRIG is 0x69696969 , this reg can be write</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lpsys_rst</name>
              <description>Only when REG_SW_RST_TRIG is 0x69696969 , this reg can be write</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>periall_rst_en</name>
              <description>1. warm reset request by one cpu will reset all peri and local cpu
0. warm reset request by one cpu will only reset local cpu
Note : peri rst will use sysrst mst also</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>othercpu_rst_en</name>
              <description>1. warm reset request by one cpu will reset other cpu's core and local cpu
0. warm reset request by one cpu will only reset local cpu</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_SW_RST_TRIG</name>
          <addressOffset>0x0000003C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>trig_rst</name>
              <description>System reset trigger register
Write 0x96969696 to enable the write of reset control
Write 0x69696969 will trigger the system if REG_SW_RST_CTRL set .</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_LPLAT_CTRL</name>
          <addressOffset>0x00000040</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00100000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SPIC_SPDUP_SIM</name>
              <description>1: SPIC will wait 256 spic_clk cycles before ready
0: SPIC will wait 2^16 spic_clk  cycles before ready</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PLFM_AUTO_ICG_EN</name>
              <description>1: Enable LS platform auto clock-gating for power save
0: Disable</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PLFM_MST0_SEL</name>
              <description>LS platfrom m0 select
0: SIC
1: OTPC
2/3: KM0
Default is OTPC for autoload , after done , pmc will set thi field to KM0 , or SIC(testmode)</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM0_RETENTION_MODE</name>
              <description>1: Enable, when KM0 reset, Cache will not be cleared 
0: Disable, when KM0 reset, Cache will be cleared by HW</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HUK_PROT</name>
              <description>0: only cpu can read HUK key
1: no one can read HUK key
This bit will be latch to high when it was write to 1 until reset again .</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_LPLAT_STATUS</name>
          <addressOffset>0x00000044</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>KM0_DBGRESTARTED_M</name>
              <description>KM0 debug restart status</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>KM0_HALTED_M</name>
              <description>KM0 halt status</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>KM0_LOCKUP_M</name>
              <description>KM0 lockup status</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>KM0_SL_SLEEPSYS_R</name>
              <description>KM0 sleep status</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>LS_IDLE</name>
              <description>Indicate LS plfm is in IDLE state , thus can change m0_select</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_SW_PATCH</name>
          <addressOffset>0x00000048</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x23008000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>sw_patch_saddr</name>
              <description>SW patch code start addr.
OTP physical addr 0x500-0x6FF will autoload to this addr .</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_SPORT_CLK</name>
          <addressOffset>0x0000004C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x11110000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ckd_sport3</name>
              <description>Sport clock divider, it is based on np i2s1 pll and i2s2 pll mux out
0: not valid
1: div2
2: div3
3/other: divider by this value + 1</description>
              <bitRange>[30:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_sport2</name>
              <description>Sport clock divider, it is based on np i2s1 pll and i2s2 pll mux out
0: not valid
1: div2
2: div3
3/other: divider by this value + 1</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_sport1</name>
              <description>Sport clock divider, it is based on np i2s1 pll and i2s2 pll mux out
0: not valid
1: div2
2: div3
3/other: divider by this value + 1</description>
              <bitRange>[22:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ckd_sport0</name>
              <description>Sport clock divider, it is based on np i2s1 pll and i2s2 pll mux out
0: not valid
1: div2
2: div3
3/other: divider by this value + 1</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_i2s3</name>
              <description>I2S pll selection for sport3
10: select i2s pll1 which is 98.304M
01: select i2s pll2 which is 45.158M
11: select i2s pll1 which is 24.576M
00: reserved</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_i2s2</name>
              <description>I2S pll selection for sport2
10: select i2s pll1 which is 98.304M
01: select i2s pll2 which is 45.158M
11: select i2s pll1 which is 24.576M
00: reserved</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_i2s1</name>
              <description>I2S pll selection for sport1
10: select i2s pll1 which is 98.304M
01: select i2s pll2 which is 45.158M
11: select i2s pll1 which is 24.576M
00: reserved</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cksl_i2s0</name>
              <description>I2S pll selection for sport0
10: select i2s pll1 which is 98.304M
01: select i2s pll2 which is 45.158M
11: select i2s pll1 which is 24.576M
00: reserved</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_BT_CTRL0</name>
          <addressOffset>0x00000050</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x0010C008</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BT_PWM_NM</name>
              <description>ECO Add.
SWR mode of BT active
1: PWM Mode
0: PFM Mode</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dummy</name>
              <description>HW used only , these are for reserved.</description>
              <bitRange>[30:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_MP_STATUS</name>
              <description>Wi-Fi MP status</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_USE_REQ</name>
              <description>who uses loguart  trx pad depends on the xor of WL_USE_REQ and BT_USE_REQ, wifi can send use request by change the value of WL_USE_REQ</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BTWL_USE_LOGUART_PAD_ST</name>
              <description>The state of xor of WL_USE_REQ and BT_USE_REQ.
0: loguart use loguart trx pad
1: bt hci use loguart trx pad</description>
              <bitRange>[24:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FORCE_LOGUART_USE_LOGUART_PAD_B</name>
              <description>Force wifi soc to use loguart pad mandatory if necessary
0: loguart use loguart trx pad
1: who uses loguart trx pad depends on BTWL_USE_LOGUART_PAD_ST</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_HW_EN_BTAFE_2REGU</name>
              <description>Control 3.3V power reset of BT afe, need level shift to 3.3V by regu, SW shall set the bit to1 when BT use BT AFE</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_HW_EN_BTAFE</name>
              <description>Core power reset of BT afe, SW shall set the bit to1 when BT use BT AFE</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_EN_TST_SI_CTRL_RFC</name>
              <description></description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_USE_EXT_UART</name>
              <description>1: BT use external uart
0: BT use internal uart</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_GPIO_FUN_SEL</name>
              <description>BT GPIO function select, 5:I2C mode</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_WAKE_HOST_POL</name>
              <description>1: BT_WAKE_HOST to CPU and pinmux
0: pinmux to CPU for external trig</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HOST_WAKE_BT_POL</name>
              <description>1: HOST_WAKE_BT to BT and pinmux
0: pinmux to BT for external trig</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HOST_WAKE_BT</name>
              <description>CPU set this bit to 1 to wake BT</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_AHB_ACCESS_GNT</name>
              <description>Access grant for system master access BT reg through AHB bus</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BT_AHB_ACCESS_REQ</name>
              <description>System master set this bit to 1 and wait  BT_AHB_ACCESS_GNT=1 before access BT reg through AHB bus, when access finish, shall set this bit to 0</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_PLL_LDO_MODE</name>
              <description>1: system force AFE PLL LDO to Power cut mode
0: AFE PLL LDO mode is controlled by BTON parameter</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_AFEPLL_EN</name>
              <description>1: system force AFE PLL enable
0: AFE PLL enable by BT PMC</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_AFELDO_EN</name>
              <description>1: system force AFE LDO enable
0: AFE LDO enable by BT PMC</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_OFF_PC_WT</name>
              <description>Wait time select for BT off power cut stable</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ASWR_REF_BT_AUD</name>
              <description>Audio swr parameter refer BT status</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ASWR_REF_BT_MEM</name>
              <description>Memory swr parameter refer BT status</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DSWR_REF_BT</name>
              <description>Core swr parameter refer BT status</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_HW_EN_BTRF_2REGU</name>
              <description>Control 3.3V power reset of BT rfc, need level shift to 3.3V by regu, SW shall set the bit to1 when BT use BT RFC</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_HW_EN_BTRF</name>
              <description>Core power reset of BT rfc, SW shall set the bit to1 when BT use BT RFC</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BT_USE_WL_RFAFE</name>
              <description>Indicate BT select WL RFAFE, shall not switch when BT is on</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
