            <field>
              <name>data_en_err_type</name>
              <description>[1:0] check result of dfi_wrdata_en_p0/p1[0]
[3:2] check result of dfi_wrdata_en_p0/p1[1]
[5:4] check result of dfi_wrdata_en_p0/p1[2]
[7:6] check result of dfi_wrdata_en_p0/p1[3]
[9:8] check result of dfi_rddata_en_p0/p1[0]
[11:10] check result of dfi_rddata_en_p0/p1[1]
[13:12] check result of dfi_rddata_en_p0/p1[2]
[15:14] check result of dfi_rddata_en_p0/p1[3]
2'b00: No error; 2'b01: burst length cycle is odd number; 2'b10: burst length cycle is 2.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
