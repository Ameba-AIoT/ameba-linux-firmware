      </addressBlock>
      <registers>
        <register>
          <name>MODE_CTRL</name>
          <addressOffset>0x00000F00</addressOffset>
          <size>32</size>
          <description>Mode Control Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MODE_CTRL_ENDIAN</name>
              <description>0x0: little
0x1: big</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>MODE_CTRL_BYTE_SWAP</name>
              <description>Byte swapping in a word
0x0: little
0x1: big</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>MODE_CTRL_KEY_SIZE_SEL</name>
              <description>0x0: 2048
0x2: 1024
0x5: 3072</description>
              <bitRange>[2:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>START_INT_CTRL</name>
          <addressOffset>0x00000F08</addressOffset>
          <size>32</size>
          <description>Start Interrupt Control Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>START_INT_CTRL_GO</name>
              <description>Write 1 to start engine</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>START_INT_CTRL_INT_EN</name>
              <description>Interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>START_INT_CTRL_INT_CLR</name>
              <description>0x0: no interrupt
0x1: interrupt active
Write 1 to clear interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
