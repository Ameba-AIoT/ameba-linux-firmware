              <name>XQSEL_RF_AWAKE</name>
              <description>0: Schmitt trigger, 1:replica INV(for OK0=1)</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>XQSEL_RF_INITIAL</name>
