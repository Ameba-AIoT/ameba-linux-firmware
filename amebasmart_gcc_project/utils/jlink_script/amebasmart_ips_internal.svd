              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NORM_IDCACHE_LS</name>
              <description>1: Enable ICACHE/DCACHE light-sleep when KM0 in active state
0: Disable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NORM_K0_RAM_LS</name>
