    <peripheral>
      <name>MIPI_DSI_REG</name>
      <baseAddress>0x400ea000</baseAddress>
      <size>0x00000C10</size>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x00000C10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>MAIN_CTRL</name>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dphy_iso_ctrl</name>
              <description>DPHY isolation function control
1: isolation mode
0: normal mode
Related to DPHY port: BY_PASS_ON_MIPI</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>aphy_pwdb</name>
              <description>APHY core power down signal for isolation</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>aphy_rstb</name>
              <description>APHY reset signal</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dphy_tx_rstn</name>
              <description>DPHY external reset</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rx_ecc_en</name>
              <description>RX ECC check and correction enable</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rx_crc_en</name>
              <description>RX CRC check enable</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>turndisable</name>
              <description>Disable Bus Turn Around (BTA) function.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tx_crc_en</name>
              <description>TX CRC calculation enable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>eotp_en</name>
              <description>EOT packet enable</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>vid_format</name>
              <description>Video stream data format
2'b00: 24bpp (8, 8, 8 RGB)
2'b01: 16bpp (5, 6, 5 RGB)
2'b10: 18bpp (6, 6, 6 RGB) packed
2'b11: 18bpp (6, 6, 6, RGB) loosely packed</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lane_num</name>
              <description>Lane number setting
2'b00: 1-lane
2'b01: 2-lane
2'b10: 3-lane
2'b11: 4-lane</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lprx_rst</name>
              <description>Async SW reset for LPRX function, set 1'b1 to reset LPRX function.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lptx_rst</name>
              <description>Async SW reset for LPTX function, set 1'b1 to reset LPTX function.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>hstx_rst</name>
              <description>Async SW reset for HSTX function, set 1'b1 to reset HSTX function.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dsi_mode</name>
              <description>DSI mode selection
0: command mode
1: video mode (shall be set after timing contrl register)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
