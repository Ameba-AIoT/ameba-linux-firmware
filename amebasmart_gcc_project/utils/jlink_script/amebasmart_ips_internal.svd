2'b01 : overflow error
2'b10 : underflow error
2'b11 : calibration in progress

[31]      :  zctrl_done
[30]      : rzq480_done
[29:24] : Reserved
[23:22] : Reserved
[21:20] : rzq480_sts
[19:18] : Reserved
[17:16] : nocd2_sts
[15:14] : Reserved
[13:12] : podt_sts
[11:10] : Reserved
[  9:  8] : nodt_sts
[  7:  6] : Reserved
[  5:  4] : pocd_sts
[  3:  2] : Reserved
[  1:  0] : nocd_sts</description>
              <bitRange>[31:0]</bitRange>
