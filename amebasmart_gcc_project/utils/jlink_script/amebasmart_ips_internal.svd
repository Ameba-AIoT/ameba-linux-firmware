0: Disable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NORM_K0_RAM_DS</name>
              <description>1: Enable CPU RAM deep-sleep when KM0 in active state
0: Disable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NORM_K0_RAM_SD</name>
              <description>ECO_137 : KM0 itcm rom SLP</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
