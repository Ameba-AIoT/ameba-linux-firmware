        <register>
          <name>i2s_1_control</name>
          <addressOffset>0x00000044</addressOffset>
          <size>32</size>
          <description>I2S 1 Control Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>i2s_1_rst_n_reg</name>
              <description>I2S 1
1'b1: rst_n to audio digital IP is de-asserted
