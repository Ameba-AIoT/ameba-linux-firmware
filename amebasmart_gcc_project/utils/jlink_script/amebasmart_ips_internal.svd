          <name>TIM_CCR3</name>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <description>TIM Capture/Compare register 3</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
