            <field>
              <name>rddata_dbi_val</name>
              <description>Only available if rddata_force = 1.
[3:0]: Control rddata_dbi value of read slice 3/2/1/0.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
