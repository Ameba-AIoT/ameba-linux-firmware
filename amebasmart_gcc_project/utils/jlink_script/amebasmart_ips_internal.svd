            </field>
            <field>
              <name>dqsen_dqs_inv</name>
              <description>0: use dqs for dqsen calibration
1: use inverted dqs for dqsen calibration (in ddr4)</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>mck_rx_inv_sel</name>
              <description>0: delay dqs_en1_set by 0.5T mck_rx
1: delay dqs_en1_set by 1T mck_rx</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dqsen_cal_sel</name>
              <description>Select dqs enable calibration algorithm.</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dqs_early_sel</name>
              <description>Select source signal of dqs early detection
0: dqs_en2
1: dqs</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tm_dqs_cal_pre</name>
              <description>for tm_dqs_en_ftun calibration
2to1 :
tm_dqs_cal_pre = tm_dqs_en - 1</description>
              <bitRange>[20:16]</bitRange>
              <access>read-write</access>
            </field>
