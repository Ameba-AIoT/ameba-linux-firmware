0: disable
1: enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pitch_det_thr_st_valid_adp_lv</name>
              <description>The level control for auto thr_st_valid
0: *2
1: /1
2: /2
3: /4
4: /8
5: /16
6: /32
7: /64</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PITCH_DET_CTRL8</name>
          <addressOffset>0x00000030</addressOffset>
