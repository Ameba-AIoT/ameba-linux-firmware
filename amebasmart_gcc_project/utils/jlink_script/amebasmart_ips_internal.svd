              <name>BIT_EN_RXBCN_GT_THRES_CNT</name>
              <description>enable the counter of BIT_RXBCN_GT_THRES_CNT</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
