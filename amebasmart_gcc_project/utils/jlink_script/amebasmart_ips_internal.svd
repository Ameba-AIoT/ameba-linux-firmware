        <register>
          <name>IR_VERSION</name>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <description>IR IP version register</description>
          <resetValue>0x1410150A</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IR_VERSION</name>
              <description>IR IP version</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>LCDC_REG</name>
      <baseAddress>0x400d8000</baseAddress>
      <size>0x000000D8</size>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x000000D8</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>LCDC_CTRL</name>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <description>LCDC control register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>lcdc_dis</name>
              <description>Disable LCDC instantly. Reset LCDC internal states and disable LCDC then clear both this bit and LCDCEN.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lcdc_en</name>
              <description>Write 1 to enable LCDC.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_PLANE_SIZE</name>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <description>LCDC plane size register</description>
          <resetValue>0x014000F0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>imageheight</name>
              <description>The height of image (Y-channel based), the min. value is 0x1.</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>imagewidth</name>
              <description>The width of image (X-channel based), the min. value is 0x1.
*For LCD, it means pixel number per line.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_UNDFLW_CFG</name>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <description>LCDC underflow configuration register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dma_un_mode</name>
              <description>*0:Output last data
*1:Output erroutdata</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>errout_data</name>
              <description>Output data when DMA FIFO underflow occurred. (directly mapping to output D[23:0])</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_DMA_MODE_CFG</name>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <description>LCDC DMA mode configuration register</description>
          <resetValue>0x0000000C</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dmaintv</name>
              <description>The interval cycle count between two DMA requests. (for debug)
Unit: bus clock cycle.</description>
              <bitRange>[31:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>lcd_dma_out</name>
              <description>Secondary RGB output port enabled, the blended data of entire image will be written back to memory. The destination address is defined in LDCD_IMG_DEST_ADDR. (for debug)</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lcdc_force_wb_en</name>
              <description>force lcdc write back memory without mipi ask signal, please tie 0 when lcdc function running. (for debug)</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rd_otsd</name>
              <description>The value of read outstanding -1, for DMA burst size configuration</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_SHW_RLD_CFG</name>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <description>LCDC shadow reload configuration register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VBR</name>
              <description>vertical blanking reload.
This bit is set by software and cleared only by hardware after reload (it cannot be cleared through register write once it is set).
0: no effect
1: The shadow registers are reloaded during the vertical blanking period (at the beginning of the first line after the active display area).</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_BKG_COLOR</name>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <description>LCDC background color register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>bkg_red</name>
              <description>Default Color Red</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bkg_green</name>
              <description>Default Color Green</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bkg_blue</name>
              <description>Default Color Blue</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_SEC_DEST_ADDR</name>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <description>LCDC second image destination address register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>img_dest_addr</name>
              <description>Image DMA destination address. (for debug)</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_DEBUG_STATUS</name>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <description>Debug signal</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>lcdc_debug_states</name>
              <description>LCDC critial signal for debug</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_IRQ_EN</name>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <description>LCDC interrupt enable register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>frm_start_inten</name>
              <description>DMA Frame start interrupt Enable. This bit can be set and cleared by software.
* 0: DMA Frame start interrupt disable
* 1: DMA Frame start interrupt enable</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lcd_lin_inten</name>
              <description>Line Interrupt Enable. This bit can be set and cleared by software.
* 0: Line interrupt disable
* 1: Line Interrupt enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lcd_frd_inten</name>
              <description>LCD refresh frame done interrupt enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dma_un_inten</name>
              <description>DMA FIFO underflow interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_IRQ_STATUS</name>
          <addressOffset>0x00000024</addressOffset>
          <size>32</size>
          <description>LCDC interrupt status register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>frm_start_ints</name>
              <description>DMA frame start interrupt status. Write 1 to clear it.
* 0: No DMA frame start interrupt generated
* 1: A DMA frame start interrupt is generated</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>lcd_lin_ints</name>
              <description>Line Interrupt status. Write 1 to clear it.
* 0: No Line interrupt generated
* 1: A Line interrupt is generated, when a programmed line is reached
Note: When this bit is set and DMA fetches the first pixel data of the specified line number from frame buffer, the line interrupt happens. The line number depends on LCDC_LINE_INT_POS register value.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>lcd_frd_ints</name>
              <description>LCD refresh frame done interrupt status. Write 1 to clear it.
* 0: No LCD refresh frame done interrupt generated.
* 1: This interrupt generated, when sending LCD frame done.
Note: When this bit is set and DMA fetch the last pixel data from frame buffer, the After LCD refresh frame done, interrupt happens.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>dma_un_ints</name>
              <description>DMA FIFO underflow interrupt status. Write 1 to clear it.
* 0: No DMA FIFO underflow interrupt generated
* 1: Interrupt generated when DMA FIFO underflow happens</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_IRQ_RAW</name>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <description>LCDC raw interrupt register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>frm_start_intrs</name>
              <description>DMA frame start raw interrupt status. No matter DMA frame start interrupt is enabled or disabled, this bit is set when DMA frame start interrupt happens. Writting 1 to the FRM_START_INTS field in register LCDC_IRQ_STATUS is to clear this bit.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>lcd_lin_intrs</name>
              <description>Line Interrupt raw status. No matter the line interrupt is enabled or disabled, this bit is set when line interrupt happens. Writting 1 to the LCD_LIN_INTS field in register LCDC_IRQ_STATUS is to clear this bit.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>lcd_frd_intrs</name>
              <description>LCD refresh frame done raw interrupt status. No matter the refresh done interrupt is enabled or disabled, this bit is set when refresh done interrupt happens. Writting 1 to the LCD_FRD_INTS field in register LCDC_IRQ_STATUS is to clear this bit.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>dma_un_intrs</name>
              <description>DMA FIFO underflow raw interrupt status. When LCDC DMA FIFO under flow event happens, this bit is set. Write 1 to the DMAUNINTS field in register LCDC_IRQ_STATUS to clear this bit.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_LINE_INT_POS</name>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <description>LCDC line interrupt position register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>line_int_pos</name>
              <description>Line Interrupt Position
These bits configure the line interrupt position.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_CUR_POS_STATUS</name>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <description>Display current position</description>
          <resetValue>0x00010001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>cur_pos_y</name>
              <description>Current Y Position
These bits return the current Y position.</description>
              <bitRange>[27:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>cur_pos_x</name>
              <description>Current X Position
These bits return the current X position.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_STATUS</name>
          <addressOffset>0x00000034</addressOffset>
          <size>32</size>
          <description>Underflow times</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>lcdcready</name>
              <description>LCDC is ready to operate with VO interface after LCDC is enabled.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>dma_unint_cnt</name>
              <description>DMA FIFO underflow interrupt count</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_LAYER0_CTRL</name>
          <addressOffset>0x00000080</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>layer0_img_format</name>
              <description>Image layer data format, it supports the following values:
*000: ARGB8888
*001: RGB888
*010: RGB565
*011: ARGB1555
*100: ARGB4444
*101: RGB666
*110: ARGB8666
*Others: Reserved</description>
              <bitRange>[7:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>layer0_color_keying_en</name>
              <description>Color Keying Enable
*0: Color Keying disable
*1: Color Keying enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>layer0_img_layer_en</name>
              <description>Image layer enable
*0: Disable
*1: Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_LAYER0_BASE_ADDR</name>
          <addressOffset>0x00000084</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>layer0_img_base_addr</name>
              <description>Image layer DMA source address.
After a frame refresh done, hardware loads the newer base address from this register automatically.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_LAYER0_WIN_XPOS</name>
          <addressOffset>0x00000088</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>layer0_win_x_stop</name>
              <description>Window Horizontal Stop Position
These bits configure the last visible pixel of a line of the layer window.
Please make sure it is in work plane,the min value is 1. Ex:32*32 picture: the x start postion is 1 and x stop postion is 32.</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>layer0_win_x_start</name>
              <description>Window Horizontal Start Position
These bits configure the first visible pixel of a line of the layer window.
Please make sure it is in work plane,the min value is 1. Ex:32*32 picture: the x start postion is 1 and x stop postion is 32.
Layer size(x*y) must &gt;=10 pixel</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_LAYER0_WIN_YPOS</name>
          <addressOffset>0x0000008C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>layer0_win_y_stop</name>
              <description>Window Vertical Stop Position
These bits configure the last visible line of the layer window.
Please make sure it is in work plane,the min value is 1. Ex:32*32 picture: the y start postion is 1 and y stop postion is 32.</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>layer0_win_y_start</name>
              <description>Window Vertical Start Position
These bits configure the first visible line of the layer window. 
Please make sure it is in work plane,the min value is 1. Ex:32*32 picture: the y start postion is 1 and y stop postion is 32.
Layer size(x*y) must &gt;=10 pixel</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_LAYER0_COLOR_KEY</name>
          <addressOffset>0x00000090</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>layer0_color_key_value</name>
              <description>Color Key value depends on the selected input color format</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_LAYER0_ALPHA</name>
          <addressOffset>0x00000094</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x000000FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>layer0_bf1</name>
              <description>Blending factor 1. This field selects the blending factor F1.
*00: Constant alpha
*01: Pixel alpha x constant alpha
*Others : Reserved</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>layer0_consta</name>
              <description>Constant alpha. This field configures the constant alpha used for blending. The constant alpha is divided by 256 by hardware.
The max. value of constant is FF, so when the constant alpha arrives the max. value, it is identified as 1.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
