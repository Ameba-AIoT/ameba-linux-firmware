              <description>Integer code of loop divider,real divider code is (target Ncode of overclocking)
CKREF=27M, REG_PDIV=b00, REG_BYPASS_PI=b0, VCO frequency=27*( REG_N_CODE [7:0] +3+ REG_F_CODE&lt;10:0&gt;/2048)=1.6GHz
-&gt;  REG_N_CODE [7:0] =56, REG_F_CODE&lt;10:0&gt;=531</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NCODE_SSC</name>
              <description>Integer code of loop divider,real divider code is 
CKREF=27M, REG_PDIV=b00, REG_BYPASS_PI=b0, VCO frequency=27*( REG_N_CODE [7:0] +3+ REG_F_CODE&lt;10:0&gt;/2048)=1.0GHz
-&gt;  REG_N_CODE [7:0] =34, REG_F_CODE&lt;10:0&gt;=76</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
