debug output enable</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_dcc_cmd_duty_sel</name>
              <description>mck_cmd duty control 
reg_dpi_dcc_cmd_duty_sel=0: 
output from close loop;
reg_dpi_dcc_cmd_duty_sel=1: 
output from reg_dpi_dcc_cmd_duty[6:0]</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_dcc_cmd_dsp_stop</name>
              <description>mck_cmd duty control 
dsp function enable</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_dcc_cmd_div</name>
              <description>mck_cmd duty control 
dsp clock frequency setting:
000~111:
/2^4~/2^11</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_dcc_cmd_int_gain</name>
              <description>mck_cmd duty control
close loop gain setting:
00000~11111:
/2^6~/2</description>
              <bitRange>[20:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_dcc_cmd_duty</name>
              <description>mck_cmd duty control 
when reg_dpi_dcc_cmd_duty_sel=1'b0,output value from this register</description>
              <bitRange>[14:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_dcc_cmd_duty_presetb</name>
              <description>mck_cmd duty control
DCD negitive duty preset setting</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpi_dcc_cmd_duty_preseta</name>
              <description>mck_cmd duty control 
DCD positive duty preset setting</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
