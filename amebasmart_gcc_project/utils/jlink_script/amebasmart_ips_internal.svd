3'b011: MIC 2 falling
3'b100: MIC 3 rising
3'b101: MIC 3 falling 
3'b110: MIC 4 rising
3'b111: MIC 4 falling</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
