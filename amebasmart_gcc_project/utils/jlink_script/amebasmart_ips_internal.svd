        <register>
          <name>KM4_PARAM</name>
          <addressOffset>0x00000108</addressOffset>
          <size>32</size>
          <description>parameter for km4 memory</description>
          <resetValue>0x0000008A</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>KM4_ITCM_MISR_SEL</name>
              <description>select km4 itcm rom misr_dataout</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM4_LS_ALL</name>
              <description>LS for all km4 memory.
 LS=1 ram is in light sleep mode, memory array's data retained.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM4_DS_ALL</name>
              <description></description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM4_SD_ALL</name>
              <description></description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM4_TEST1_ALL</name>
              <description>Test1 pin to bypass self-timed circuit. The external clock controls the read and write controls.
The self time bypass mode occpuied High phase of external clock.
The self time bypass mode may used to determine time margin of internal self-timed circuitry.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM4_RME_ALL</name>
              <description>RME for all km4 memory.
RME selects between internal and external RM[2:0] settings, RM[3] is not controlled by RME.
RME=1: select external RM[2:0]
RME=0: select internal RM[2:0]</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM4_RM32_ALL</name>
              <description>RM32 for all km4 memory.
RM[3:2] are used for test purpose.</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM4_ITCM0_E0_RM10</name>
              <description>SNPS_ULP_SPROM, for KM4 itcm0~7 : 
RM[1:0] are used to trade-off betwwen speed and robustness(yield).
2'b11 - fast
2'b10 - default
2'b01 - slow
2'b00 - VDDmin
RM[3:2] are used for test purpose.</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM4_ICACHE_E0_RM10</name>
              <description>SNPS_ULP_SPRAM
RM[1:0] are used to trade-off betwwen speed and robustness(yield).
2'b11 - fast
2'b10 - default
2'b01 - slow
2'b00 - VDDmin
RM[3:2] are used for test purpose.</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KM4_DCACHE_E0_RM10</name>
              <description>SNPS_ULP_SPRAM
RM[1:0] are used to trade-off betwwen speed and robustness(yield).
2'b11 - fast
2'b10 - default
2'b01 - slow
2'b00 - VDDmin
RM[3:2] are used for test purpose.</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
