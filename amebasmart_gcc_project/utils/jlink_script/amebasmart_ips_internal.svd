              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SLEP_IDCACHE_LS</name>
              <description>1: Enable ICACHE/DCACHE light-sleep when KM0 in sleep state
0: Disable</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SLEP_K0_RAM_LS</name>
              <description>1: Enable CPU RAM light-sleep when KM0 in sleep state
0: Disable</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SLEP_K0_RAM_DS</name>
              <description>1: Enable CPU RAM deep-sleep when KM0 in sleep state
0: Disable</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SLEP_K0_RAM_SD</name>
