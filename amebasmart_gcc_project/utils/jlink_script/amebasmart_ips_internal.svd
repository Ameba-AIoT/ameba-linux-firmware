              <bitRange>[6:6]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>write_en_1</name>
              <description>Enable of the following row</description>
              <bitRange>[3:3]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>fw_set_rd_dly</name>
              <description>FW set read delay chain TE and Delta of data slice (one cycle pulse, HW auto clear)</description>
              <bitRange>[2:2]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>write_en_0</name>
              <description>Enable of the following row</description>
