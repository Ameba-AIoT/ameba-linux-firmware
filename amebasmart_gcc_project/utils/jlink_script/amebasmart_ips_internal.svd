0001:5dB
0010:10dB
0011:15dB
0100:20dB
0101:25dB
0110:30dB
0111:35dB
1XXX:40dB</description>
              <bitRange>[9:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MICBST3_MUTE</name>
