              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_inv_sclk</name>
              <description>I2S 1
1'b1: I2S/PCM bit clock is inverted</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_self_lpbk_en</name>
              <description>I2S 1
1'b1: internal loopback mode is enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_same_lrc_en</name>
              <description>I2S 1
1'b1: LRC_TX share to LRC_RX</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_tdm_mode_rx</name>
              <description>I2S 1 Rx channel TDM mode
0: 2 channels 
1: 4 channels
2: 6 channels
3: 8 channels</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_data_format_sel_tx</name>
              <description>I2S 1 Tx channel data format
2'b00: I2S
2'b01: left-justified
2'b10: PCM mode A
2'b11: PCM mode B</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_data_format_sel_rx</name>
              <description>I2S 1 Rx channel data format
2'b00: I2S
2'b01: left-justified
2'b10: PCM mode A
2'b11: PCM mode B</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_data_len_sel_tx</name>
              <description>I2S 1 Tx channel data length
2'b00: 16 bits
2'b10: 24 bits
2'b11: 8 bits</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_1_data_len_sel_rx</name>
