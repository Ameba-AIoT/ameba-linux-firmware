            </field>
            <field>
              <name>afifo_full</name>
              <description>0: Raw code FIFO not full
1: Raw code FIFO full</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
