          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dqsen_cal_offset4</name>
              <description>0: DQSEN Calibration offset + 2
1: DQSEN Calibration offset + 4</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dqsen_dqs_inv</name>
              <description>0: use dqs for dqsen calibration
