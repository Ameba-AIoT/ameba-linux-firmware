000: Icp=10uA,  001: Icp=15uA,  010: Icp=20uA,  011: Icp=25uA;    100: Icp=30uA,  101: Icp=35uA,  110: Icp=40uA,  111: Icp=450uA;</description>
              <bitRange>[28:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
