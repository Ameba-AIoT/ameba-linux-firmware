01: 16us; 
10: 128us; 
11: 1024us.
EEPROM and register configurable.</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEEP_Timer_RX_SLEEP</name>
