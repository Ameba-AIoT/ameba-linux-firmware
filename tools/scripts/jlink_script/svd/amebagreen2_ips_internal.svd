    <peripheral>
      <name>SDIO</name>
      <baseAddress>0x4011_4000</baseAddress>
      <size>0x00000B88</size>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x00000B88</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SRAM_CTL</name>
          <addressOffset>0x00000A00</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x021F0200</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>buf_read_size</name>
              <description>Buffer Data Port Read Size (BDPRS) 
2'b00: 1-byte access, port_a_rd_ptr increment by 1 
2'b01: 2-byte access, port_a_rd_ptr increment by 2 
2'b10: 4-byte access, port_a_rd_ptr increment by 4 
2'b11: decoding byte enable(BE[3:0]) bus signal 
If block-size is odd-byte, please set buf_read_size=2'b00</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ahbm_hprot_cfg</name>
              <description>AHB bus Protection control</description>
              <bitRange>[23:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ahbm_hburst_cfg</name>
              <description>bit[3]: ena_incrx_align: alignment Burst Type enable  
bit[2]: ena_inc16: INCR16 Burst Type Enable 
bit[1]: ena_inc8: INCR8 Burst Type Enable 
bit[0]: ena_inc4: INCR4 Burst Type Enable</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Lx_swap</name>
              <description>Reserved</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Lx_burst_size</name>
              <description>2'b11: Reserved 
2'b10:burst length = 256 bytes (64 Dwords) 
2'b01: burst length = 128 bytes (32 Dwords) 
2'b00: burst length = 64 bytes (16 Dwords)</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>mcu_buf_access</name>
              <description>in bit[0] = 1 condition,  
bit[2:1] = 'b00 : buf access disable. 
bit[2:1] = 'b01 : buf abs access enable, ring buffer address is direct mapping to 0x4005_CB00 ~ 0x4005_CEFF. (mcu_addr[15:0]=0000~3FF, mcu_cs_buf_absolute) 
bit[2:1] = 'b10: buf auto access enable, ring buffer could be access by register (mcu_addr=FE30~FE33, mcu_cs_buf_auto) 
0x4005_CB30 (sram data [7:0]), 
0x4005_CB31 (sram data [15:8]), 
0x4005_CB32 (sram data [23:16]), 
0x4005_CB33 (sram data [31:24]), 
address will auto increase by 4. 
bit[2:1] = 'b11 : buf access disable.</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>mcu_sel</name>
              <description>0: elbi I/F (dword access for SDIO host standard register) 
1: mcu I/F (byte access for SDIO IP register)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CTL</name>
          <addressOffset>0x00000A10</addressOffset>
          <size>32</size>
