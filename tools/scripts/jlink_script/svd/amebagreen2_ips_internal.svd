              <bitRange>[19:19]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BIT_SPEC_FORCE_DOZE1_1</name>
              <description>If NoA_Count == 1, this value is 1. else 0.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BIT_SPEC_NOA0_OFF_PERIOD_1</name>
