            <field protection="s">
              <name>crypto_clk_opt</name>
              <description>1X: always ON
01: always OFF
00: controlled by internal ICG</description>
              <bitRange>[31:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>km4ns_sev_in</name>
              <description>cpu1 sev input, posedge of this bit will trig cpu1 event</description>
