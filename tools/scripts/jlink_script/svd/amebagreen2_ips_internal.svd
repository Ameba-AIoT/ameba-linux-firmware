Bit0~15: Layer0~15</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LLP</name>
          <addressOffset>0x00000010</addressOffset>
