            </field>
            <field>
              <name>de_circuit</name>
              <description>Indicate which AES engine has the decryption circuit.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>chn_aes_gcm_xts_circuit</name>
          <addressOffset>0x00000FF8</addressOffset>
