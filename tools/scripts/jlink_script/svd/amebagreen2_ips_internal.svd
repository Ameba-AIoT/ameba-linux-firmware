              <name>cksl_hp</name>
              <description>HP clock select,used for KM4 and sram
##x0: xtal
##01: usb_pll
##11: sys_pll</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
