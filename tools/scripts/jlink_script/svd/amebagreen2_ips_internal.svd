        <register>
          <name>FLUSH_DONE</name>
          <addressOffset>0x0000E030</addressOffset>
          <size>32</size>
          <description>Indicate flush is complete</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FLUSH_DONE</name>
              <description>Indicate flush is complete</description>
