              <name>SL1_CFG_CAL_JMIN</name>
              <description>Minimum J . Hardware may adjust J , if J reach this value , an interrup will be raised to alerm software.</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
