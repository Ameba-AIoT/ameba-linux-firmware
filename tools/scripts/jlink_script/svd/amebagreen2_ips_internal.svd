    </peripheral>
    <peripheral>
      <name>SHA_REG</name>
      <baseAddress>0x40124000</baseAddress>
      <size>0x00001000</size>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x00001000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SHA_Control</name>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <description>HMAC engine control register</description>
          <resetValue>0x00007020</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[31:25]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>soft_reset_trigger_busy</name>
              <description>Write 1 to trigger a soft reset.
All registers except the mutex register will be reset.
Read the bit until 0 to determine if the soft reset is complete.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[23:15]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FIFO_full_suspend</name>
              <description>User writes data to SHA_FIFO_in but the FIFO space is full.
0x0: accept signal is always asserted
0x1: accept signal is not asserted until FIFO space is available
Note: This function is only available when Slave_mode = 0x1</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Key_byte_inversion_enable</name>
              <description>0x0: use native byte order in memory
0x1: inverse byte order of read data</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Payload_byte_inversion_enable</name>
              <description>0x0: use native byte order in memory
0x1: inverse byte order of read data</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tSHA512_use_256</name>
              <description>Only available when config SUPPORT_TRUNCATED_SHA512 and SHA512_truncate_en= 0x1 (truncated SHA-512)
0: SHA-512/224 mode
1: SHA-512/256 mode</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SHA512_truncate_en</name>
              <description>Only available when config SUPPORT_TRUNCATED_SHA512 and SHA_mode = 0x3 (SHA-512)
0: normal SHA-512
1: truncated SHA-512</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HMAC_Key_size</name>
              <description>Only available when config HMAC_MODE
0x0: 128 bits
0x1: 192 bits
0x2: 256 bits</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Slave_mode</name>
              <description>0: DMA mode.
1: slave mode. SW can push data by wrting FIFO Data Register in slave mode.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ICG_enable</name>
              <description>Enable auto clock gating</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HMAC_mode</name>
              <description>Only available when config HMAC_MODE
0x0: use HASH mode.
0x1: use HMAC mode.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DMA_mode</name>
              <description>0x0: read-only mode
0x1: copy mode</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SHA2_mode</name>
              <description>0x0: SHA-224
0x1: SHA-256
0x2: SHA-384
0x3: SHA-512</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SHA_Status</name>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <description>HMAC engine status register</description>
          <resetValue>0x00000010</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[31:29]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>Engine_busy</name>
              <description>1: engine busy</description>
              <bitRange>[28:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[27:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FIFO_space</name>
              <description>Number of available FIFO space in byte</description>
              <bitRange>[4:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HMAC_Block_control</name>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <description>HMAC engine block control register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[31:29]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>End_slave_input</name>
              <description>Avaliable when using slave mode
If all input data has been completed, set this bit to 1 to start padding.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>last_block</name>
              <description>Indicates this operation is the last block.
If set to SHA2 mode, the padding step will be executed at the end.
If set to HMAC mode, the o_pad step will be executed at the end.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>first_block</name>
              <description>Indicates this operation is the first block.
If set to SHA2 mode, the digest will be initialized automatically.
If set to HMAC mode, the i_pad step will be executed first.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
