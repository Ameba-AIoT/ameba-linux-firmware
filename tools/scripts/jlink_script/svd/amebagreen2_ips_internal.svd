        </register>
        <register>
          <name>CAN_RAM_FDDATA_0</name>
          <addressOffset>0x0000033C</addressOffset>
          <size>32</size>
          <description>CAN data</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_data_0_3</name>
