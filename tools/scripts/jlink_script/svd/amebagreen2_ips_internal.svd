0x30: S3-0~1,5,7(AHB) group secure default slave                                                                                                                                                                                                0x31: S3-2~4,6,13~22(AHB) group secure default slave                                                                                                                                                                                              0x32: S3-8(AXI) secure default slave                                                                                                                                                                                                0x33:S3-9~10(SPIC)group  secure default slave                                                                                                                                                                                              0x34: S3-11~12(PSRAM)group  secure default slave                                                                                                                                                                                                 0x60: S4-0~6 secure default slave                                                                                                                                                                                     0x61: S4-7~15 secure default slave                                                                                                                                                                                           0x70: S5 secure default slave                                                                                                                                                                                                 0x71: MPC/PPC secure default slave                                                                                                                                                                                       0x80: S8 secure default slave</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
