it will be set to 1</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>cksl_lperi</name>
              <description>LPERI clock select
##0: osc4m
##1: xtal_40m</description>
