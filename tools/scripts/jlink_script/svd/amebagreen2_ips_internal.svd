              <access>read-write</access>
            </field>
            <field>
              <name>vref_sel</name>
              <description>000:0.800V 001:0.825V 010:0.850V
011:0.875V 100:0.900V 101:0.950V 
110:1.000V 111:1.050V</description>
              <bitRange>[10:8]</bitRange>
