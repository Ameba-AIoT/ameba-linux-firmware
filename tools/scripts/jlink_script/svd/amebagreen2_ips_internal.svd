          </fields>
        </register>
        <register>
          <name>SHA256_digest_alias_6</name>
          <addressOffset>0x00000118</addressOffset>
          <size>32</size>
          <description>SHA256 Hash value register 6</description>
          <resetValue>0xDB0C2E0D</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SHA256_Digest_alias_6</name>
              <description>SHA256 Hash value 6. Reset value is SHA384 IV.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SHA256_digest_alias_7</name>
          <addressOffset>0x0000011C</addressOffset>
          <size>32</size>
          <description>SHA256 Hash value register 7</description>
          <resetValue>0x47B5481D</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SHA256_Digest_alias_7</name>
              <description>SHA256 Hash value 7. Reset value is SHA384 IV.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>dma_hs_cfg</name>
          <addressOffset>0x00000120</addressOffset>
          <size>32</size>
          <description>DMA hardware handshake configuration register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[31:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>dma_hs_msize</name>
              <description>The expected number of burst write transaction length.
Please set this field to 3'b000 to avoid data loss.</description>
              <bitRange>[5:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dma_hs_tr_width</name>
              <description>The expected data width of each write transaction from DMA.
Since the engine uses the APB protocol, please set the field to 3'b010.</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>dma_hs_block_ts</name>
          <addressOffset>0x00000124</addressOffset>
          <size>32</size>
          <description>DMA hardware handshake block transfer size register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dma_hs_block_ts</name>
              <description>Total number of data byte for requesting DMA</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>dma_hs_buff_byte</name>
          <addressOffset>0x00000128</addressOffset>
          <size>32</size>
          <description>DMA hardware handshake buffer data byte of engine register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[31:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>dma_hs_buff_byte</name>
              <description>The register indicates number of data byte which has been processed in engine.
This number will not larger than block size of engine.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>dma_hs_en</name>
          <addressOffset>0x0000012C</addressOffset>
          <size>32</size>
          <description>DMA hardware handshake enable register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[31:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>dma_hs_en</name>
              <description>Once the register is enabled, the engine starts to send dma_req until received wdata reaches trans_data_request.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>Mutex_status</name>
          <addressOffset>0x00000D00</addressOffset>
          <size>32</size>
          <description>Mutex status register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[31:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>Engine_mutex_status</name>
              <description>If read 0, lock mutex.
If not 0, the engine is being used.
2'b01: secure domain lock mutex
2'b10: non-secure domain lock mutex
Write 0 to unlock mutex</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>Mutex_overwrite</name>
          <addressOffset>0x00000D04</addressOffset>
          <size>32</size>
          <description>Mutex overwrite register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[31:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>Engine_mutex_overwrite</name>
              <description>Allows secure domain overwrite mutex
1: enable
0: disable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>Configuration</name>
          <addressOffset>0x00000FF0</addressOffset>
          <size>32</size>
          <description>Configuration information register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[31:15]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DISABLE_CORE_SM3</name>
              <description>1: SM3 is disabled by hardware
0: SM3 is enabled</description>
              <bitRange>[14:14]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DISABLE_CORE_SHA1</name>
              <description>1: SHA1 is disabled by hardware
0: SHA1 is enabled</description>
              <bitRange>[13:13]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DISABLE_CORE_SHA2</name>
              <description>1: SHA2 is disabled by hardware
0: SHA2 is enabled</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[11:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SM3_CORE_EN</name>
              <description>1: SM3 is implmented
0: SM3 is not implmented</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SHA1_CORE_EN</name>
              <description>1: SHA1 is implmented
0: SHA1 is not implmented</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TRUST_ZONE_EN</name>
              <description>0: disabled
1: enabled</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>KEY_MANAGER_EN</name>
              <description>0: disabled
1: enabled</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>EXTERNAL_KEY_EN</name>
              <description>0: disabled
1: enabled</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SUPPORT_COPY_MODE</name>
              <description>0: disabled
1: enabled</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SUPPORT_HMAC_MODE</name>
              <description>0: disabled
1: enabled</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SUPPORT_TRUNCATED_SHA512</name>
              <description>0: disabled
1: enabled</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SUPPORT_SHA512</name>
              <description>0: disabled
1: enabled</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
