              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>fen_ledc</name>
              <description>1: Enable led display function
0: Disable
Note: this module is in syson power domain</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>fen_sdm</name>
              <description>1: Enable 32.768K SDM function
0: Disable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>fen_atim</name>
