          <name>CLEARERR_H</name>
          <addressOffset>0x0000035C</addressOffset>
          <size>32</size>
          <description>Clear for non-secure access secure register error if defined</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
