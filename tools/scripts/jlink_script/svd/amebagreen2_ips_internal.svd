              <access>read-write</access>
            </field>
            <field>
              <name>RESULT_LAYER_PIC_WIDTH</name>
              <description>Canvas width (in pixels)
Must be greater than 0.</description>
              <bitRange>[10:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
