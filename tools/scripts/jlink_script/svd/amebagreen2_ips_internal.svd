          <name>MASKERR_L</name>
          <addressOffset>0x00000330</addressOffset>
          <size>32</size>
          <description>Mask for IntErr Interrupt</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MASKERR_L_INT_MASK_WE</name>
              <description>Interrupt Mask Write Enable(chn0-chn7)
0 = write disabled
1 = write enabled</description>
