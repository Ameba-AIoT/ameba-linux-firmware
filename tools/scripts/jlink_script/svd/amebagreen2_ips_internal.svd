          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CLEARERR_L_Clear_Protocol_Error</name>
              <description>Interrupt clear for chn0-chn15. (Protocol error)</description>
              <bitRange>[15:0]</bitRange>
              <access>write-only</access>
            </field>
