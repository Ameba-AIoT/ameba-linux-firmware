          <description>The number of transfer data is not immediately returned after cache line hits in the stream buffer</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DATA_DELAY</name>
              <description>The number of cache line hits after prefetch</description>
              <bitRange>[23:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
