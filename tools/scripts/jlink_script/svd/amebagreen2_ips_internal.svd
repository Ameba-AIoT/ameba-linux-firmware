              <name>BIT_MGQ_FIFO_INT_MASK</name>
              <description>The mask of the MGQ FIFO PKT release interrupt.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
