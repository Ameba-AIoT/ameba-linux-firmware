        <register>
          <name>CAN_RAM_ARB</name>
          <addressOffset>0x00000340</addressOffset>
          <size>32</size>
          <description>CAN message buffer arb field configuration</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_rtr</name>
              <description>can frame RTR bit, determine DATA or REMOTE frame</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_ide</name>
              <description>can frame IDE bit, determine standard or extend format</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_id</name>
              <description>can frame ID, including high 11 bit standard ID and low 18 bit extend ID</description>
              <bitRange>[28:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_RAM_MASK</name>
          <addressOffset>0x00000344</addressOffset>
          <size>32</size>
          <description>CAN message buffer arb field mask configuration</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_rtr_mask</name>
              <description>can frame RTR mask, 0 means don't care, 1 means the bit should match</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_ide_mask</name>
              <description>can frame IDE mask, 0 means don't care, 1 means the bit should match</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_id_mask</name>
              <description>can frame ID mask, 0 means the ID bit in CAN_RAM_ARB don't care, 1 means the bit should match.</description>
              <bitRange>[28:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_RAM_CS</name>
          <addressOffset>0x00000348</addressOffset>
          <size>32</size>
          <description>CAN message type control</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_timestamp</name>
              <description>the received message time stamp</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_esi</name>
              <description>FD frame esi bit, indicate error passive of message sending node, read bit, should always write 0, hardware automatic fill</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_brs</name>
              <description>FD frame brs bit, indicate switch bit timing</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_edl</name>
              <description>FD frame edl bit, indicate it's a FD frame</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_autoreply</name>
              <description>set the message buffer with remote frame auto reply function</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_rxtx</name>
              <description>can frame RX or TX, 0 is for RX, 1 is for TX</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_lost</name>
              <description>data have lost in the read buffer, means more than one frame have beed received since last read; only avaliable when rx FIFO is disabled</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_dlc</name>
              <description>data length</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_RAM_CMD</name>
          <addressOffset>0x0000034C</addressOffset>
          <size>32</size>
          <description>CAN message buffer access control</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_start</name>
              <description>start to exchange data with RAM, the bit will clear automatically after the data change is finshed.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_dir</name>
              <description>0 is for read from RAM to CAN_RAM_* registers, 1 is for write from CAN_RAM_* to RAM</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
