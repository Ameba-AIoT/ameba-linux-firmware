              <bitRange>[29:26]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ElR_PROT</name>
              <description>AxProt of the error request.</description>
              <bitRange>[25:23]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ELR_SIZE</name>
              <description>Size of the error request.</description>
              <bitRange>[18:16]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_ID</name>
          <addressOffset>0x00001148</addressOffset>
          <size>32</size>
          <description>Error log ID information register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELR_ID</name>
              <description>Tagid of the error request.
9'b00001????: M1 access error
9'b000100110: M5-0 access error
9'b000100111: M5-1 access error</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_ADR0</name>
          <addressOffset>0x0000114C</addressOffset>
          <size>32</size>
          <description>Error log addrress register0</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELR_ADR0</name>
              <description>Address[31:0] of the error request.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_ADR1</name>
          <addressOffset>0x00001150</addressOffset>
          <size>32</size>
          <description>Error log addrress register1</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELR_ADR1</name>
              <description>Address[63:32] of the error request.</description>
              <bitRange>[63:32]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_CODE</name>
          <addressOffset>0x00001170</addressOffset>
          <size>32</size>
          <description>Error code register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELR_CODE</name>
              <description>The error code of error request, if it's 0, indicates that there is no error request. 
8'h00: No error
8'h01: Address hole error</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_INTR_CLR</name>
          <addressOffset>0x0000117C</addressOffset>
          <size>32</size>
          <description>Error log clear register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELR_INTR_CLR</name>
              <description>Error log interrupt clear. Writing 1'b1 to the register will trigger a 1-cycle pulse interrupt clear. It has to write 1'b1 to this register every time when the error exception occurs.
Note that this register is write-only, the return value of reading this register is meaningless.</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_GUARD_EN</name>
          <addressOffset>0x00001300</addressOffset>
          <size>32</size>
          <description>Timeout guardian enable register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GUARDIAN_MODE_EN</name>
              <description>The enable of timeout monitor group                                                                                                                                     
0x0: Disable timeout check feature
0x1: Enable timeoute check feature</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_CLEAN_N</name>
          <addressOffset>0x00001340</addressOffset>
          <size>32</size>
          <description>Timeout clear register</description>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TIMEOUT_CLEAR_N</name>
              <description>The register can only written to 0 when a time out occures, and automatically clear this register by hardware</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_MON_CFG</name>
          <addressOffset>0x00001380</addressOffset>
          <size>32</size>
          <description>Timeout monitor configuration register0</description>
          <resetValue>0x000F00FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GRADE</name>
              <description>Timeout grade                                                                                                                                                                                                                                      Timeout total cycle = [256*(2^(grade-1) +1)*threshold] - inaccurate                                                                                                       Note: the range of inaccurate = 0 ~ [256*(2^(grade-1) +1)-2]</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>THRESHOLD</name>
              <description>Timeout threshold</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PREFETCH_CTRL</name>
          <addressOffset>0x0000E000</addressOffset>
