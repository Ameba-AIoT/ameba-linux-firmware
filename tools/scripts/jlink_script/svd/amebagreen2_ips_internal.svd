            <field>
              <name>SEC_END4</name>
              <description>SEC region 4 end address[31:12].
This is 4KB aligned address.
Note: Available only if configuration of PSRAM_EN is defined.</description>
              <bitRange>[31:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SEC_R4_MODE</name>
              <description>SEC region 4 - function mode/seed selection.
Select one of mode/seed from SEC_NONCE0~SEC_NONCE7</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SEC_R4_EN</name>
              <description>Set to enable SEC region 4 to scramble write data and descramble read data.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SEC_NONCE_4</name>
          <addressOffset>0x00000238</addressOffset>
          <size>32</size>
          <description>SEC region 4 nonce register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SEC_NONCE4</name>
              <description>Only present if SEC_CONF_MODE &gt; 0.
Seed of scrambler mode 4.
This register value cannot be 0, otherwise the encrypted data will be equal to the original data.
Note: Available only if configuration of PSRAM_EN is defined.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SEC_BASE_5</name>
          <addressOffset>0x0000023C</addressOffset>
