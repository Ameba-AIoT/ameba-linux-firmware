              <bitRange>[11:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>XAAC_BUSY</name>
              <description>for XAAC debug</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>PK_END_AR</name>
