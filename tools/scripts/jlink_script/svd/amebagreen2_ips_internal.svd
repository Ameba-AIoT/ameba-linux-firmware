              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sample_rate_1</name>
              <description>Set sample rate source 1
4'h0: 48K
4'h1: 96K
4'h2: 192K
4'h3: 32K
4'h4: 176.4K
4'h5: 16K
4'h6: Reserved
4'h7: 8K
4'h8: 44.1K
4'h9: 88.2K
4'ha:24K
4'hb: 12K
4'hc: 22.05K
