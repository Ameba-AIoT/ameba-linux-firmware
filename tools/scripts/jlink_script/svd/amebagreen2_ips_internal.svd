          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RANDOM_NUMBER</name>
              <description>RNG data register 0. Read as 0x0 if RNG valid register is not a ready status.
A Read access triggers a buffer pop, so the value is only read once then be discarded.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
