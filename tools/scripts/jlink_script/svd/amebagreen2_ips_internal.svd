          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TIMEOUT_CLEAR_N</name>
              <description>The register can only written to 0 when a time out occures, and automatically clear this register by hardware</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_MON_CFG</name>
          <addressOffset>0x00001380</addressOffset>
