            </field>
            <field>
              <name>rx_fs_phase_rpt_b5</name>
              <description>rx_fs_phase_rptp[5] when using div64 fs_phase_trace_cnt</description>
              <bitRange>[27:27]</bitRange>
              <access>read-only</access>
            </field>
