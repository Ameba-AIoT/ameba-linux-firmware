        <register>
          <name>BUS_ERR_DTL</name>
          <addressOffset>0x00000050</addressOffset>
          <size>32</size>
          <description>BUS error detail register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>WR_ERR</name>
              <description>The mark for write error response
Assert this bit when receiving error response from axi B cahnnel</description>
