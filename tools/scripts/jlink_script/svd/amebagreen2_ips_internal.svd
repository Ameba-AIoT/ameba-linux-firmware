          <description>The number of master conmmand</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMD_NUM</name>
              <description>The number of master command</description>
              <bitRange>[23:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EVENT_PREFETCH_CNT</name>
          <addressOffset>0x0000E024</addressOffset>
          <size>32</size>
          <description>The number of prefetch</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PREFETCH_NUM</name>
              <description>The number of prefetch</description>
              <bitRange>[23:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EVENT_PREFETCH_HIT_CNT</name>
          <addressOffset>0x0000E028</addressOffset>
          <size>32</size>
          <description>The number of cache line hits after prefetch</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PREFETCH_HIT</name>
              <description>The number of transfer data is not immediately returned after cache line hits in ther stream buffer</description>
              <bitRange>[23:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EVENT_DATA_DELAY_CNT</name>
          <addressOffset>0x0000E02C</addressOffset>
