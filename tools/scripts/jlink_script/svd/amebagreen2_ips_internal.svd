        </register>
        <register>
          <name>SP_CTRL2</name>
          <addressOffset>0x00000070</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dummy</name>
              <description></description>
              <bitRange>[31:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lrc_start_pol</name>
              <description>1: lrclk rising edge as lrc start
0: lrclk falling edge as lrc start</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rx_dma_single_low</name>
              <description>disable rx_dma_single</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tx_dma_single_low</name>
              <description>disable tx_dma_single</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lrc_stop_intr_mask</name>
              <description></description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lrc_start_intr_mask</name>
              <description></description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ex_phase_cnt_en</name>
              <description>enable t/rx exact phase counter, counted by sport_clk</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lrc_stop_thresh</name>
              <description>either tx or rx excat phase counter &gt; this value, generate lrc_stop_intr</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TX_FIFO_0_WR_ADDR</name>
          <addressOffset>0x00000800</addressOffset>
