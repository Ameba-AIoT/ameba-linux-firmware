          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_mb_txint_en</name>
              <description>tx interrupt enable for each message buffer</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_INT_FLAG</name>
          <addressOffset>0x00000024</addressOffset>
          <size>32</size>
          <description>CAN interrupt flags</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ram_move_done_int_flag</name>
              <description>data move from register to CAN IP internal RAM finished interupt, move from RAM to register done will NOT generate interrupt, write one to clear</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>busoff_int_flag</name>
              <description>busoff interrupt flag, write one to clear</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>wakeup_int_flag</name>
              <description>wakeup interrupt flag, write one to clear</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>error_int_flag</name>
              <description>error interrupt flag, write to clear</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>rx_int_flag</name>
              <description>rx interrupt flag, write to clear</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>tx_int_flag</name>
              <description>tx interrupt flag, write to clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_ERR_STATUS</name>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <description>CAN error status</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_error_rx</name>
              <description>can rx error flag</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_error_tx</name>
              <description>can tx error flag</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_error_ack</name>
              <description>latest error  is ack error</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_error_stuff</name>
              <description>latest error  is stuff error</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_error_crc</name>
              <description>latest error  is ctc error</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_error_form</name>
              <description>latest error  is form error</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_error_bit1</name>
              <description>latest error  is bit1 error, tx=1 but rx=0</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_error_bit0</name>
              <description>latest error  is bit0 error, tx=0 but rx=1</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_ERR_CNT_CTL</name>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <description>CAN bus error counter control</description>
          <resetValue>0x00006000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_error_warn_th</name>
              <description>error counter warning threshold, programable, default 96. NOTES: 0~127 is availaible to both TEC and REC, 128~255 is only available to TEC</description>
              <bitRange>[16:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rx_err_cnt_clr</name>
              <description>write 1 to clear can_rec</description>
              <bitRange>[1:1]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>tx_err_cnt_clr</name>
              <description>write 1 to clear can_tec</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_ERR_CNT_STS</name>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <description>CAN bus error counter status</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_error_warning</name>
              <description>error counter arrive at warning threshold</description>
              <bitRange>[30:30]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_error_busoff</name>
              <description>error counter arrive at bus off level</description>
              <bitRange>[29:29]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_error_passive</name>
              <description>error counter arrive at error passive level</description>
              <bitRange>[28:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_rec</name>
              <description>receive error count</description>
              <bitRange>[24:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>can_tec</name>
              <description>transmit error count</description>
              <bitRange>[8:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
