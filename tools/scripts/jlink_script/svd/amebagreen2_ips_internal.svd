          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IDR0</name>
              <description>The ID register0-5 are only permitted to write by 4-byte access. Read access can be byte, word, or double word access.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
