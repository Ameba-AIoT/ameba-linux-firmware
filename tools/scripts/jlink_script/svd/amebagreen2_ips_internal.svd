· Elements E12, E21, E31~E33 are RO if SUPPORT_ROTATION_i = 0.
· Elements E31~E33 are RO if SUPPORT_PERSPECTIVE_i = 0.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
