0: Release</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>iso_aon_otp</name>
              <description>1: ISO signals from otp core power domain
0: Release</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>iso_lpon</name>
