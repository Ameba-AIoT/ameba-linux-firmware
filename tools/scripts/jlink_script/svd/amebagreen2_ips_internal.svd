          <description>Clear for IntTfr Interrupt</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CLEARTFR_L_Clear_Tfr</name>
              <description>Interrupt clear for chn0-chn15
0 = no effect
1= clear interrupt</description>
              <bitRange>[15:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CLEARBLOCK_L</name>
          <addressOffset>0x00000340</addressOffset>
          <size>32</size>
