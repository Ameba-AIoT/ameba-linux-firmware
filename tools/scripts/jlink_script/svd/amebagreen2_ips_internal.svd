        <register>
          <name>REG_WLRFC_CTRL</name>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000036</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>wlrfc_pwc_en</name>
              <description>1: gen request of wlan rfc power cut
0: gen request of turn off wlan rfc power cut</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>iso_wlrfc_en</name>
              <description>Isolation control for wlan rfc
1: isolation
0: attach</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>wlrfc_retain_en_type_1</name>
              <description>1 to 0:gen req to restore register in power on flow
0 to 1:gen req to backup register in power on flow
default should be 1,otherwise there be unexpected leakage power when VCC is power off and VCCG is still on</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>wlrfc_pwc_sel</name>
              <description>Option to turn off wlrfc pwr cut
1: enable 
0: disable
RL6973: RFC without retention FF. default is 0</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>wlafe_ckrfc_en</name>
              <description>1: enable WLRFC clock; 0: gated</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>wlrfc_clk_sel</name>
              <description>rfc clock divider, it is based on 320m wlpll
0: div1
1: div2
2: div3
3/other: divider by this value + 1,(default is 3:80M)</description>
              <bitRange>[7:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>wlrfc_save_en_type_2</name>
              <description>enable saving value of retention DFF when wlmac power off or pg,should be assert when reset is high</description>
              <bitRange>[8:8]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>wlrfc_restore_en_type_2</name>
              <description>enable restoring value of retention DFF when wlmac power on,should be assert when reset is high</description>
              <bitRange>[9:9]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>wlrfc_retention_cell_sel</name>
              <description>1:choose retention cell type I(U22 ULP),which is controlled by 0x28[2]
0:choose retention cell type II(RTKM),which is controlled by 0x28[9:8]</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dis_wlbb_ckrfc_en</name>
              <description>the gating control of rfc clk is pta_ckrfc_en|wlbb_ckrfc_en|wlafe_ckrfc_en,and wlbb_ckrfc_en can not be control by register directly in RL6678,add option for top to control wlbb_ckrfc_en
1: disable wlbb_ckrfc_en; 0: enable wlbb_ckrfc_en</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
