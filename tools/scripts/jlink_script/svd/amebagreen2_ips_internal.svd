              <name>pmc_prg_dly</name>
              <description>regu_pmc programmable delay value
0: 100us
1: 500us
2: 1ms
3: 2ms
4: 10ms
5: 50ms
6: 100ms
7: 200ms</description>
              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
            </field>
