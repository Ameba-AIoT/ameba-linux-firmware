        <register>
          <name>ISR1_REG</name>
          <addressOffset>0x000000D8</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ISR_TDU5</name>
              <description>Tx Descriptor Ring5 Unavailable: When set, indicates Tx descriptor Ring5 is unavailable. 
Write 1 to clear.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_TDU4</name>
              <description>Tx Descriptor Ring4 Unavailable: When set, indicates Tx descriptor Ring5 is unavailable. 
Write 1 to clear.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_TDU3</name>
              <description>Tx Descriptor Ring3 Unavailable: When set, indicates Tx descriptor Ring5 is unavailable. 
Write 1 to clear.</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_TDU2</name>
              <description>Tx Descriptor Ring2 Unavailable: When set, indicates Tx descriptor Ring5 is unavailable. 
Write 1 to clear.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_TDU1</name>
              <description>This bit is ISR.tdu</description>
              <bitRange>[24:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_TOK5</name>
              <description>Transmit Interrupt:   Indicates that the DMA of the last Ring5 descriptor of TxIntMitigation number of Tx packet has completed and the last descriptor has been closed.  
Write 1 to clear.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_TOK4</name>
              <description>Transmit Interrupt:   Indicates that the DMA of the last Ring4 descriptor of TxIntMitigation number of Tx packet has completed and the last descriptor has been closed.  
Write 1 to clear.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_TOK3</name>
              <description>Transmit Interrupt:   Indicates that the DMA of the last Ring3 descriptor of TxIntMitigation number of Tx packet has completed and the last descriptor has been closed.  
Write 1 to clear.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_TOK2</name>
              <description>Transmit Interrupt:   Indicates that the DMA of the last Ring2 descriptor of TxIntMitigation number of Tx packet has completed and the last descriptor has been closed.  
Write 1 to clear.</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_TOK1</name>
              <description>This bit is ISR.tok</description>
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_ROK6</name>
              <description>Receive (Rx) OK:   This interrupt is set either when RxIntMitigation packet is met or RxPktTimer expires in Ring6.  
Write 1 to clear.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_ROK5</name>
              <description>Receive (Rx) OK:   This interrupt is set either when RxIntMitigation packet is met or RxPktTimer expires in Ring5.  
Write 1 to clear.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_ROK4</name>
              <description>Receive (Rx) OK:   This interrupt is set either when RxIntMitigation packet is met or RxPktTimer expires in Ring4.  
Write 1 to clear.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_ROK3</name>
              <description>Receive (Rx) OK:   This interrupt is set either when RxIntMitigation packet is met or RxPktTimer expires in Ring3.  
Write 1 to clear.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_ROK2</name>
              <description>Receive (Rx) OK:   This interrupt is set either when RxIntMitigation packet is met or RxPktTimer expires in Ring2.  
Write 1 to clear.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ISR_ROK1</name>
              <description>This bit is ISR.rok</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
