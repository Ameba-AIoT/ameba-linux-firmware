              <description>Indicate whether DMA is used (suppoty DMA mode or not)</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>core_select_lock</name>
              <description>Indicate whether the core_select was locked by hardware pin.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>key_management_en</name>
              <description>Indicate whether to use key_management.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>trustzone_en</name>
              <description>Indicate whether to use TrustZone.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>gf_mask_en</name>
              <description>Indicate whether to use SCA countermeasure.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>chn_aes_en_de_circuit</name>
          <addressOffset>0x00000FF4</addressOffset>
          <size>32</size>
          <description>Enable circuit status register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
