          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DETECT_NUM_SINGLE</name>
              <description>The number of required sequential single accesses before initiating prefetch</description>
              <bitRange>[23:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DETECT_NUM_BURST</name>
              <description>The number of required sequential cache line accesses before initiating prefetch</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PREFETCH_DIST</name>
              <description>The size of prefech data                                                                                                                                       
2'b00: no prefetch
2'h01: one cache line                                                                                                                                                                                        2'h1?: two cache line</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>REMAIN_ENTRY</name>
              <description>The remaining number of valid entries in the stream buffer required before automatically intiating prefetch.(support up to 16)</description>
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADDR_REGION</name>
          <addressOffset>0x0000E004</addressOffset>
          <size>32</size>
          <description>The address region that requires prefetch</description>
          <resetValue>0x6FFF6000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ADDR_TOP</name>
              <description>The top address boundary of prefetch. (only consider address[31:16])</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDR_BASE</name>
              <description>The base address boundary of prefetch. (only consider address[31:16])</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
