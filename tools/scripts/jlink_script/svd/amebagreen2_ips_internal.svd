              <bitRange>[29:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BIT_FCSOK_CHK_BSSID</name>
              <description>1:HW will check bssid when fcsok</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BIT_DRVERLYITV_P1</name>
