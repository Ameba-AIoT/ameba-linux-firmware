              <name>MASKERR_H_INT_MASK_WE</name>
              <description>Interrupt Mask Write Enable(chn0-chn7)
0 = write disabled
1 = write enabled
These bits only exist when DMAC_ SECURE_MODE has beed defined</description>
              <bitRange>[15:8]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>MASKERR_H_INT_MASK</name>
              <description>Interrupt Mask(chn0-chn7)
0 = masked
1 = unmasked
These bits only exist when DMAC_ SECURE_MODE has beed defined</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CLEARTFR_L</name>
