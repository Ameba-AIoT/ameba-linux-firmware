              <bitRange>[21:21]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>bit_adc_dat_ovw_ch7</name>
              <description>This bit indicates that there is a data overwritten situation in bit_adc_data_global takeing place. A data overwritten situation is that a former conversion data is NOT read before a new conversion is written to data field. It would be cleared to 0 when a read operation of reg_adc_data_ch7.
0: There is no data overwritten case.
1: There is a data overwritten case.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>bit_adc_num_ch7</name>
              <description>This field contains the newsest conversion data of channel 7
[19:16]: which channel in channel list the data belongs to, only valid when bit_adc_ch_unmask=1</description>
              <bitRange>[19:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>bit_adc_data_ch7</name>
              <description>This field contains the newsest conversion data of channel 7
[15:0]: newest data</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
